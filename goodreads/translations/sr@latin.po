#: ..\common\common_dialogs.py:84
msgid "Keyboard shortcuts"
msgstr "Prečice na tastaturi"

#: ..\common\common_dialogs.py:112
msgid "Restart calibre now"
msgstr "Ponovo pokreni calibre sada"

#: ..\common\common_dialogs.py:128
msgid "Preferences for:"
msgstr "Podešavanja za:"

#: ..\common\common_dialogs.py:160
msgid "Clear"
msgstr "Obriši"

#: ..\common\common_dialogs.py:162
msgid "Clear all settings for this plugin"
msgstr "Obriši sva podešavanja ovog dodatka"

#: ..\common\common_dialogs.py:189
msgid ""
"Are you sure you want to change your settings in this library for this "
"plugin?"
msgstr ""
"Da li ste sigurni da želite da promenite podešavanja ovog dodatka u ovoj "
"biblioteci?"

#: ..\common\common_dialogs.py:190 ..\common\common_dialogs.py:210
msgid ""
"Any settings in other libraries or stored in a JSON file in your calibre "
"plugins folder will not be touched."
msgstr ""
"Podešavanja u drugim bibliotekama, kao ni ona sačuvana u JSON datoteci u "
"fascikli dodataka za calibre, neće biti promenjena."

#: ..\common\common_dialogs.py:192 ..\common\common_dialogs.py:212
msgid "You must restart calibre afterwards."
msgstr "Nakon toga morate ponovo pokrenuti calibre."

#: ..\common\common_dialogs.py:200
msgid "Settings changed"
msgstr "Podešavanja su promenjena"

#: ..\common\common_dialogs.py:201
msgid "Settings for this plugin in this library have been changed."
msgstr "Podešavanja ovog dodatka u ovoj biblioteci su promenjena."

#: ..\common\common_dialogs.py:202 ..\common\common_dialogs.py:223
msgid "Please restart calibre now."
msgstr "Ponovo pokrenite calibre sada."

#: ..\common\common_dialogs.py:209
msgid ""
"Are you sure you want to clear your settings in this library for this "
"plugin?"
msgstr ""
"Da li ste sigurni da želite da obrišete podešavanja ovog dodatka u ovoj "
"biblioteci?"

#: ..\common\common_dialogs.py:221
msgid "Settings deleted"
msgstr "Podešavanja su obrisana"

#: ..\common\common_dialogs.py:222
msgid "All settings for this plugin in this library have been cleared."
msgstr "Sva podešavanja ovog dodatka u ovoj biblioteci su obrisana."

#: ..\common\common_dialogs.py:297
msgid "Copy to clipboard"
msgstr "Kopiraj u privremenu memoriju"

#: ..\common\common_widgets.py:105
msgid "Undefined"
msgstr "Nedefinisano"

#: ..\common\common_widgets.py:160
msgid "Restart required"
msgstr "Potrebno je ponovno pokretanje"

#: ..\common\common_widgets.py:161
msgid ""
"Title image not found - you must restart Calibre before using this plugin!"
msgstr ""
"Slika naslova nije pronađena — morate ponovo pokrenuti calibre pre "
"korišćenja ovog dodatka!"

#: ..\common\common_widgets.py:234
msgid "Create new column"
msgstr "Napravi novu kolonu"

#: config.py:154
msgid "Goodreads Genre"
msgstr "Goodreads žanr"

#: config.py:154
msgid "Maps to Calibre Tag"
msgstr "Odgovarajuća oznaka u calibre-u"

#: config.py:223
msgid "Goodreads genre to calibre tag mappings"
msgstr "Povezivanje Goodreads žanrova sa oznakama u calibre-u"

#: config.py:228
msgid "Filter and map genres to calibre tags"
msgstr "Filtriraj žanrove i poveži ih sa oznakama u calibre-u"

#: config.py:229
msgid ""
"When checked, only specific calibre tags will be used as per below.\n"
"When unchecked, all Goodreads genres will be added as tags."
msgstr ""
"Ako je ova opcija uključena, koristiće se samo oznake u calibre-u navedene ispod.\n"
"Ako nije uključena, svi Goodreads žanrovi biće dodati kao oznake."

#: config.py:242
msgid "Add genre mapping"
msgstr "Dodaj povezivanje žanra"

#: config.py:249
msgid "Delete genre mapping"
msgstr "Obriši povezivanje žanra"

#: config.py:256
msgid "Rename Goodreads genre"
msgstr "Preimenuj Goodreads žanr"

#: config.py:263
msgid "Reset to plugin default mappings"
msgstr "Vrati podrazumevana povezivanja dodatka"

#: config.py:269
msgid "Other options"
msgstr "Ostale opcije"

#: config.py:274
msgid "Scan multiple editions for title/author searches (slower)"
msgstr "Proveri više izdanja pri pretrazi po naslovu i autoru (sporije)"

#: config.py:275
msgid ""
"When checked will perform an additional search to scan the top ranked\n"
"Goodreads editions (if available) to exclude audiobook editions.\n"
"When unchecked you will get a faster search but the edition is indeterminate."
msgstr ""
"Ako je ova opcija uključena, dodatna pretraga proverava najbolje rangirana\n"
"izdanja na Goodreads-u (ako postoje) i isključuje audio-izdanja.\n"
"Ako nije uključena, pretraga je brža, ali izdanje neće biti pouzdano određeno."

#: config.py:281
msgid "Get all contributing authors (e.g. illustrators, series editors etc)"
msgstr "Preuzmi sve saradnike (npr. ilustratore i urednike serijala)"

#: config.py:282
msgid ""
"When this option is checked, all authors are retrieved.\n"
"\n"
"When unchecked (default) only the primary author(s) are returned."
msgstr ""
"Kada je ova opcija označena, preuzimaju se podaci o svim autorima i saradnicima.\n"
"\n"
"Kada nije označena (podrazumevano), preuzimaju se samo podaci o glavnim autorima."

#: config.py:287
msgid "Get ASIN for kindle editions"
msgstr "Preuzmi ASIN za Kindle izdanja"

#: config.py:288
msgid ""
"When this option is checked, in cases where Goodreads has an ASIN listed\n"
"instead of an ISBN, the ASIN is retrieved. This is useful for books that\n"
"already have the specific Goodreads identifier of a Kindle editon."
msgstr ""
"Ako je ova opcija uključena, preuzima se ASIN kada Goodreads navodi ASIN\n"
"umesto ISBN-a. To je korisno za knjige koje već imaju poseban Goodreads\n"
"identifikator Kindle izdanja."

#: config.py:294
msgid "Use first published date"
msgstr "Koristi datum prvog objavljivanja"

#: config.py:295
msgid ""
"If checked, the first published date for this book is used rather than\n"
"that of the actual book edition."
msgstr ""
"Ako je ova opcija uključena, koristi se datum prvog objavljivanja knjige,\n"
"a ne datum objavljivanja konkretnog izdanja."

#: config.py:300
msgid "Get precise rating into 'grrating' identifier"
msgstr "Upiši preciznu ocenu u identifikator „grrating“"

#: config.py:301
msgid ""
"If checked, pulls precise rating (e.g. 3.78) into an identifier\n"
"you can display as a custom column."
msgstr ""
"Ako je ova opcija uključena, precizna ocena (npr. 3.78) upisuje se u\n"
"identifikator koji možete prikazati u prilagođenoj koloni."

#: config.py:306
msgid "Get #votes for rating into 'grvotes' identifier"
msgstr "Upiši broj glasova za ocenu u identifikator „grvotes“"

#: config.py:307
msgid ""
"If checked, pulls number of votes producing this rating into an identifier\n"
"you can display as a custom column."
msgstr ""
"Ako je ova opcija uključena, broj glasova na osnovu kojih je ocena dobijena\n"
"upisuje se u identifikator koji možete prikazati u prilagođenoj koloni."

#: config.py:328 config.py:359
msgid "Add new mapping"
msgstr "Dodaj novo povezivanje"

#: config.py:329 config.py:360
msgid "Enter a Goodreads genre name to create a mapping for:"
msgstr ""
"Unesite naziv Goodreads žanra za koji želite da napravite povezivanje:"

#: config.py:340
msgid "Add Failed"
msgstr "Dodavanje nije uspelo"

#: config.py:340 config.py:372
msgid "A genre with the same name already exists"
msgstr "Žanr sa istim nazivom već postoji"

#: config.py:348 config.py:379
msgid "Are you sure?"
msgstr "Da li ste sigurni?"

#: config.py:349
msgid "Are you sure you want to delete the selected genre mappings?"
msgstr "Da li ste sigurni da želite da obrišete izabrana povezivanja žanrova?"

#: config.py:372
msgid "Rename Failed"
msgstr "Preimenovanje nije uspelo"

#: config.py:380
msgid "Are you sure you want to reset to the plugin default genre mappings?"
msgstr ""
"Da li ste sigurni da želite da vratite podrazumevana povezivanja žanrova "
"ovog dodatka?"
