#: ..\common\common_dialogs.py:84
msgid "Keyboard shortcuts"
msgstr "Klávesové skratky"

#: ..\common\common_dialogs.py:112
msgid "Restart calibre now"
msgstr "Reštartovať calibre teraz"

#: ..\common\common_dialogs.py:128
msgid "Preferences for:"
msgstr "Nastavenia pre:"

#: ..\common\common_dialogs.py:160
msgid "Clear"
msgstr "Vymazať"

#: ..\common\common_dialogs.py:162
msgid "Clear all settings for this plugin"
msgstr "Vymazať všetky nastavenia tohto zásuvného modulu"

#: ..\common\common_dialogs.py:189
msgid ""
"Are you sure you want to change your settings in this library for this "
"plugin?"
msgstr ""
"Naozaj chcete zmeniť nastavenia tohto zásuvného modulu v tejto knižnici?"

#: ..\common\common_dialogs.py:190 ..\common\common_dialogs.py:210
msgid ""
"Any settings in other libraries or stored in a JSON file in your calibre "
"plugins folder will not be touched."
msgstr ""
"Nastavenia v iných knižniciach ani nastavenia uložené v súbore JSON v "
"priečinku zásuvných modulov calibre nebudú zmenené."

#: ..\common\common_dialogs.py:192 ..\common\common_dialogs.py:212
msgid "You must restart calibre afterwards."
msgstr "Potom musíte reštartovať calibre."

#: ..\common\common_dialogs.py:200
msgid "Settings changed"
msgstr "Nastavenia zmenené"

#: ..\common\common_dialogs.py:201
msgid "Settings for this plugin in this library have been changed."
msgstr "Nastavenia tohto zásuvného modulu v tejto knižnici boli zmenené."

#: ..\common\common_dialogs.py:202 ..\common\common_dialogs.py:223
msgid "Please restart calibre now."
msgstr "Teraz prosím reštartujte calibre."

#: ..\common\common_dialogs.py:209
msgid ""
"Are you sure you want to clear your settings in this library for this "
"plugin?"
msgstr ""
"Naozaj chcete vymazať nastavenia tohto zásuvného modulu v tejto knižnici?"

#: ..\common\common_dialogs.py:221
msgid "Settings deleted"
msgstr "Nastavenia vymazané"

#: ..\common\common_dialogs.py:222
msgid "All settings for this plugin in this library have been cleared."
msgstr ""
"Všetky nastavenia tohto zásuvného modulu v tejto knižnici boli vymazané."

#: ..\common\common_dialogs.py:297
msgid "Copy to clipboard"
msgstr "Kopírovať do schránky"

#: ..\common\common_widgets.py:105
msgid "Undefined"
msgstr "Nedefinované"

#: ..\common\common_widgets.py:160
msgid "Restart required"
msgstr "Vyžaduje sa reštart"

#: ..\common\common_widgets.py:161
msgid ""
"Title image not found - you must restart Calibre before using this plugin!"
msgstr ""
"Obrázok titulu sa nenašiel – pred použitím tohto zásuvného modulu musíte "
"reštartovať calibre!"

#: ..\common\common_widgets.py:234
msgid "Create new column"
msgstr "Vytvoriť nový stĺpec"

#: config.py:154
msgid "Goodreads Genre"
msgstr "Žáner Goodreads"

#: config.py:154
msgid "Maps to Calibre Tag"
msgstr "Mapuje sa na značku calibre"

#: config.py:223
msgid "Goodreads genre to calibre tag mappings"
msgstr "Mapovania žánrov Goodreads na značky calibre"

#: config.py:228
msgid "Filter and map genres to calibre tags"
msgstr "Filtrovať a mapovať žánre na značky calibre"

#: config.py:229
msgid ""
"When checked, only specific calibre tags will be used as per below.\n"
"When unchecked, all Goodreads genres will be added as tags."
msgstr ""
"Po začiarknutí sa použijú len konkrétne značky calibre podľa nižšie uvedeného zoznamu.\n"
"Po odčiarknutí sa všetky žánre Goodreads pridajú ako značky."

#: config.py:242
msgid "Add genre mapping"
msgstr "Pridať mapovanie žánru"

#: config.py:249
msgid "Delete genre mapping"
msgstr "Odstrániť mapovanie žánru"

#: config.py:256
msgid "Rename Goodreads genre"
msgstr "Premenovať žáner Goodreads"

#: config.py:263
msgid "Reset to plugin default mappings"
msgstr "Obnoviť predvolené mapovania zásuvného modulu"

#: config.py:269
msgid "Other options"
msgstr "Ďalšie možnosti"

#: config.py:274
msgid "Scan multiple editions for title/author searches (slower)"
msgstr "Prehľadávať viac vydaní pri vyhľadávaní podľa názvu/autora (pomalšie)"

#: config.py:275
msgid ""
"When checked will perform an additional search to scan the top ranked\n"
"Goodreads editions (if available) to exclude audiobook editions.\n"
"When unchecked you will get a faster search but the edition is indeterminate."
msgstr ""
"Po začiarknutí sa vykoná dodatočné vyhľadávanie na prehľadanie\n"
"najlepšie hodnotených vydaní Goodreads (ak sú k dispozícii) s cieľom\n"
"vylúčiť audioknižné vydania.\n"
"Po odčiarknutí bude vyhľadávanie rýchlejšie, ale vydanie nebude určené."

#: config.py:281
msgid "Get all contributing authors (e.g. illustrators, series editors etc)"
msgstr ""
"Získať všetkých spolupracujúcich autorov (napr. ilustrátorov, editorov sérií"
" atď.)"

#: config.py:282
msgid ""
"When this option is checked, all authors are retrieved.\n"
"\n"
"When unchecked (default) only the primary author(s) are returned."
msgstr ""
"Ak je táto možnosť začiarknutá, získajú sa všetci autori.\n"
"\n"
"Ak nie je začiarknutá (predvolené), vrátia sa len hlavní autori."

#: config.py:287
msgid "Get ASIN for kindle editions"
msgstr "Získať ASIN pre vydania Kindle"

#: config.py:288
msgid ""
"When this option is checked, in cases where Goodreads has an ASIN listed\n"
"instead of an ISBN, the ASIN is retrieved. This is useful for books that\n"
"already have the specific Goodreads identifier of a Kindle editon."
msgstr ""
"Ak je táto možnosť začiarknutá, v prípadoch, keď má Goodreads uvedený\n"
"ASIN namiesto ISBN, sa získa ASIN. Je to užitočné pre knihy, ktoré\n"
"už majú konkrétny identifikátor Goodreads pre vydanie Kindle."

#: config.py:294
msgid "Use first published date"
msgstr "Použiť dátum prvého vydania"

#: config.py:295
msgid ""
"If checked, the first published date for this book is used rather than\n"
"that of the actual book edition."
msgstr ""
"Po začiarknutí sa použije dátum prvého vydania tejto knihy namiesto\n"
"dátumu konkrétneho vydania knihy."

#: config.py:300
msgid "Get precise rating into 'grrating' identifier"
msgstr "Získať presné hodnotenie do identifikátora 'grrating'"

#: config.py:301
msgid ""
"If checked, pulls precise rating (e.g. 3.78) into an identifier\n"
"you can display as a custom column."
msgstr ""
"Po začiarknutí sa presné hodnotenie (napr. 3,78) uloží do identifikátora,\n"
"ktorý môžete zobraziť ako vlastný stĺpec."

#: config.py:306
msgid "Get #votes for rating into 'grvotes' identifier"
msgstr "Získať počet hlasov pre hodnotenie do identifikátora 'grvotes'"

#: config.py:307
msgid ""
"If checked, pulls number of votes producing this rating into an identifier\n"
"you can display as a custom column."
msgstr ""
"Po začiarknutí sa počet hlasov tvoriacich toto hodnotenie uloží do\n"
"identifikátora, ktorý môžete zobraziť ako vlastný stĺpec."

#: config.py:328 config.py:359
msgid "Add new mapping"
msgstr "Pridať nové mapovanie"

#: config.py:329 config.py:360
msgid "Enter a Goodreads genre name to create a mapping for:"
msgstr "Zadajte názov žánru Goodreads, pre ktorý chcete vytvoriť mapovanie:"

#: config.py:340
msgid "Add Failed"
msgstr "Pridanie zlyhalo"

#: config.py:340 config.py:372
msgid "A genre with the same name already exists"
msgstr "Žáner s rovnakým názvom už existuje"

#: config.py:348 config.py:379
msgid "Are you sure?"
msgstr "Naozaj?"

#: config.py:349
msgid "Are you sure you want to delete the selected genre mappings?"
msgstr "Naozaj chcete odstrániť vybrané mapovania žánrov?"

#: config.py:372
msgid "Rename Failed"
msgstr "Premenovanie zlyhalo"

#: config.py:380
msgid "Are you sure you want to reset to the plugin default genre mappings?"
msgstr "Naozaj chcete obnoviť predvolené mapovania žánrov zásuvného modulu?"
