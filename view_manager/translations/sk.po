msgstr ""
"Rozdelený zoznam kníh sa zobrazí len vtedy, ak je táto možnosť začiarknutá. "
"Začiarkne sa automaticky, ak uložíte rozdelené zobrazenie."

#: config.py:529
msgid "Sort order"
msgstr "Poradie zoradenia"

#: config.py:532
msgid "Move sort column up"
msgstr "Posunúť stĺpec zoradenia nahor"

#: config.py:535
msgid "Move sort down"
msgstr "Posunúť zoradenie nadol"

#: config.py:566
msgid "Search and Virtual Library Options"
msgstr "Možnosti vyhľadávania a virtuálnej knižnice"

#: config.py:574
msgid "Apply saved search"
msgstr "Použiť uložené vyhľadávanie"

#: config.py:575
msgid "Apply the selected saved search when the View is activated."
msgstr "Po aktivácii zobrazenia použije vybrané uložené vyhľadávanie."

#: config.py:583
msgid "Switch to Virtual library"
msgstr "Prepnúť na virtuálnu knižnicu"

#: config.py:584
msgid "Switch to the selected Virtual library when the View is activated."
msgstr "Po aktivácii zobrazenia prepne na vybranú virtuálnu knižnicu."

#: config.py:586
msgid "Virtual library to switch to."
msgstr "Virtuálna knižnica, na ktorú sa má prepnúť."

#: config.py:591
msgid "Apply VL additional search restriction"
msgstr "Použiť dodatočné obmedzenie vyhľadávania VK"

#: config.py:592
msgid ""
"Apply the selected saved search as a Virtual library additional restriction "
"when the View is activated."
msgstr ""
"Po aktivácii zobrazenia použije vybrané uložené vyhľadávanie ako dodatočné "
"obmedzenie virtuálnej knižnice."

#: config.py:593
msgid "Clear VL restriction search"
msgstr "Vymazať vyhľadávanie obmedzenia VK"

#: config.py:594
msgid "Saved search to apply as VL additional search restriction."
msgstr "Uložené vyhľadávanie, ktoré sa použije ako dodatočné obmedzenie VK."

#: config.py:608
msgid "General Options"
msgstr "Všeobecné možnosti"

#: config.py:613
msgid "Jump to the top when applying this View"
msgstr "Pri použití tohto zobrazenia skočiť na začiatok"

#: config.py:617
msgid "When restarting Calibre or switching to this library"
msgstr "Pri reštarte calibre alebo prepnutí na túto knižnicu"

#: config.py:618
msgid "Automatically apply view:"
msgstr "Automaticky použiť zobrazenie:"

#: config.py:624
msgid ""
"Enabling this option may override any startup search restriction or title "
"sort set in Preferences -> Behaviour/Tweaks."
msgstr ""
"Zapnutie tejto možnosti môže prepísať akékoľvek obmedzenie vyhľadávania pri "
"spustení alebo zoradenie podľa názvu nastavené v časti Nastavenia -> "
"Správanie/Úpravy."

#: config.py:637
msgid "Edit the keyboard shortcuts associated with this plugin"
msgstr "Upraviť klávesové skratky priradené tomuto zásuvnému modulu"

#: config.py:639
