msgid "You must specify a web domain url"
msgstr "Morate navesti URL adresu veb-domena"

#: config.py:607
msgid "You must specify a source file."
msgstr "Morate navesti izvornu datoteku."

#: config.py:613
msgid "Source image does not exist!"
msgstr "Izvorna slika ne postoji!"

