msgstr "Odefinierad"

#: ..\common\common_widgets.py:160
msgid "Restart required"
msgstr "Kräver omstart"

#: ..\common\common_widgets.py:161
msgid ""
"Title image not found - you must restart Calibre before using this plugin!"
msgstr ""
"Titelbilden hittades inte. Du måste starta om calibre innan du kan använda "
"insticksmodulen."

#: ..\common\common_widgets.py:234
msgid "Create new column"
msgstr "Skapa ny kolumn"

#: config.py:49
msgid "Other options"
msgstr "Andra alternativ"

#: config.py:54
msgid "Include 'Genres' in the Tags column"
msgstr "Ta med genrer i kolumnen Taggar"

#: config.py:55
msgid ""
"When checked if a book has any genres defined they will be\n"
"returned in the Tags column from this plugin."
msgstr ""
"Markera rutan för att lägga till bokens genrer i kolumnen Taggar\n"
"om de finns angivna i FictionDB."

#: config.py:60
msgid "Include 'Sub-Genres' in the Tags column"
msgstr "Ta med undergenrer i kolumnen Taggar"

#: config.py:61
msgid ""
"When checked if a book has any Sub-Genres defined they will be\n"
"returned in the Tags column from this plugin."
msgstr ""
"Markera rutan för att lägga till bokens undergenrer i kolumnen Taggar\n"
"om de finns angivna i FictionDB."

#: config.py:66
msgid "Include 'Themes' in the Tags column"
msgstr "Ta med teman i kolumnen Taggar"

#: config.py:67
msgid ""
"When checked if a book has any Themes defined it will be\n"
"returned in the Tags column from this plugin."
msgstr ""
"Markera rutan för att lägga till bokens teman i kolumnen Taggar\n"
"om de finns angivna i FictionDB."

#: config.py:72
msgid "Include 'Characters && Occupations' in the Tags column"
msgstr "Ta med rollfigurer och yrken i kolumnen Taggar"

#: config.py:73
msgid ""
"When checked, if a book has 'Characters & Occupations' defined they will be\n"
"returned in the Tags column from this plugin."
msgstr ""
"Markera rutan för att lägga till rollfigurer och yrken i kolumnen Taggar\n"
"om de finns angivna för boken i FictionDB."

#: config.py:78
msgid "Include 'Age Level' in the Tags column"
msgstr "Ta med åldersgrupp i kolumnen Taggar"

#: config.py:79
msgid ""
"When checked, if a book has an 'Age Level' defined it will be\n"
"returned in the Tags column from this plugin."
msgstr ""
"Markera rutan för att lägga till bokens åldersgrupp i kolumnen Taggar\n"
"om den finns angiven i FictionDB."
