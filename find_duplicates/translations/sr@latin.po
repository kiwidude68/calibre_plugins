#: dialogs.py:1037
msgid ""
"<b>Book duplicate search</b><br/>- Report books in this library which have "
"an identical identifier for books in the target library.<br/>"
msgstr ""
"<b>Pretraga duplikata knjiga</b><br/>- Prijavi knjige u ovoj biblioteci koje"
" imaju identičan identifikator za knjige u ciljnoj biblioteci.<br/>"

#: dialogs.py:1041
msgid ""
"<b>Book duplicate search</b><br/>- Report books in this library which are "
"binary identical to books in your target library.<br/>- Compares the actual "
"file size of every book format in your libraries, computing an SHA hash to "
"compare contents where sizes match.<br/>- Books found using this search are "
"guaranteed to be duplicates."
msgstr ""
"<b>Pretraga duplikata knjiga</b><br/>- Prijavi knjige u ovoj biblioteci koje"
" su binarno identične knjigama u vašoj ciljnoj biblioteci.<br/>- Upoređuje "
"stvarnu veličinu datoteke svakog formata knjige u vašim bibliotekama, "
"računajući SHA heš za poređenje sadržaja gde se veličine podudaraju.<br/>- "
"Knjige pronađene pomoću ove pretrage garantovano su duplikati."

#: dialogs.py:1048
msgid ""
"<b>Title duplicate search</b><br/>- Report books in this library compared to"
" your target library with an <b>identical title</b> and {0}<br/>- Titles "
"must match exactly excluding case."
msgstr ""
"<b>Pretraga duplikata naslova</b><br/>- Prijavi knjige u ovoj biblioteci u "
"poređenju sa vašom ciljnom bibliotekom sa <b>identičnim naslovom</b> i "
"{0}<br/>- Naslovi se moraju tačno podudarati isključujući velika i mala "
"slova."

#: dialogs.py:1051
msgid ""
"<b>Title duplicate search</b><br/>- Report books in this library compared to"
" your target library with a <b>similar title</b> and {0}<br/>- Similar title"
" matches apply removal of common punctuation and prefixes and applies the "
"same title matching logic as Automerge."
msgstr ""
"<b>Pretraga duplikata naslova</b><br/>- Prijavi knjige u ovoj biblioteci u "
"poređenju sa vašom ciljnom bibliotekom sa <b>sličnim naslovom</b> i "
"{0}<br/>- Podudaranja sličnih naslova primenjuju uklanjanje uobičajene "
"interpunkcije i prefiksa i primenjuju istu logiku podudaranja naslova kao "
"Automerge."

#: dialogs.py:1055
msgid ""
"<b>Title duplicate search</b><br/>- Report books in this library compared to"
" your target library with a <b>soundex title</b> and {0}<br/>- Soundex title"
" matches are based on the same removal of punctuation and common prefixes as"
" a similar title search."
msgstr ""
"<b>Pretraga duplikata naslova</b><br/>- Prijavi knjige u ovoj biblioteci u "
"poređenju sa vašom ciljnom bibliotekom sa <b>soundex naslovom</b> i "
"{0}<br/>- Podudaranja soundex naslova zasnivaju se na istom uklanjanju "
"interpunkcije i uobičajenih prefiksa kao i pretraga sličnih naslova."

#: dialogs.py:1059
msgid ""
"<b>Title duplicate search</b><br/>- Report books in this library compared to"
" your target library with a <b>fuzzy title</b> and {0}<br/>- Fuzzy title "
"matches remove all punctuation, subtitles and any words after 'and', 'or' or"
" 'aka' in the title."
msgstr ""
"<b>Pretraga duplikata naslova</b><br/>- Prijavi knjige u ovoj biblioteci u "
"poređenju sa vašom ciljnom bibliotekom sa <b>približnim naslovom</b> i "
"{0}<br/>- Podudaranja približnih naslova uklanjaju svu interpunkciju, "
"podnaslove i sve reči posle 'and', 'or' ili 'aka' u naslovu."

#: dialogs.py:1063
msgid ""
"<b>Author duplicate search</b><br/>- Report books in this library compared "
"to your target library <b>ignoring title</b> with {0}<br/>- Ignore title "
"searches are best to find variations of author names regardless of the books"
" you have for each."
msgstr ""
"<b>Pretraga duplikata autora</b><br/>- Prijavi knjige u ovoj biblioteci u "
"poređenju sa vašom ciljnom bibliotekom <b>zanemarujući naslov</b> sa "
"{0}<br/>- Pretrage koje zanemaruju naslov najbolje su za pronalaženje "
"varijacija imena autora bez obzira na knjige koje imate za svakog."

