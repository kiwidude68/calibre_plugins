#: dialogs.py:1037
msgid ""
"<b>Book duplicate search</b><br/>- Report books in this library which have "
"an identical identifier for books in the target library.<br/>"
msgstr ""
"<b>Hľadanie duplikátov kníh</b><br/>- Nahlási knihy v tejto knižnici, ktoré "
"majú identický identifikátor s knihami v cieľovej knižnici.<br/>"

#: dialogs.py:1041
msgid ""
"<b>Book duplicate search</b><br/>- Report books in this library which are "
"binary identical to books in your target library.<br/>- Compares the actual "
"file size of every book format in your libraries, computing an SHA hash to "
"compare contents where sizes match.<br/>- Books found using this search are "
"guaranteed to be duplicates."
msgstr ""
"<b>Hľadanie duplikátov kníh</b><br/>- Nahlási knihy v tejto knižnici, ktoré "
"sú binárne identické s knihami vo vašej cieľovej knižnici.<br/>- Porovnáva "
"skutočnú veľkosť súboru každého formátu knihy vo vašich knižniciach a pri "
"zhode veľkostí vypočíta SHA hash na porovnanie obsahu.<br/>- Knihy nájdené "
"týmto hľadaním sú zaručene duplikáty."

#: dialogs.py:1048
msgid ""
"<b>Title duplicate search</b><br/>- Report books in this library compared to"
" your target library with an <b>identical title</b> and {0}<br/>- Titles "
"must match exactly excluding case."
msgstr ""
"<b>Hľadanie duplikátov názvov</b><br/>- Nahlási knihy v tejto knižnici v "
"porovnaní s vašou cieľovou knižnicou s <b>identickým názvom</b> a {0}<br/>- "
"Názvy sa musia zhodovať presne okrem veľkosti písmen."

#: dialogs.py:1051
msgid ""
"<b>Title duplicate search</b><br/>- Report books in this library compared to"
" your target library with a <b>similar title</b> and {0}<br/>- Similar title"
" matches apply removal of common punctuation and prefixes and applies the "
"same title matching logic as Automerge."
msgstr ""
"<b>Hľadanie duplikátov názvov</b><br/>- Nahlási knihy v tejto knižnici v "
"porovnaní s vašou cieľovou knižnicou s <b>podobným názvom</b> a {0}<br/>- "
"Zhody podobných názvov odstraňujú bežnú interpunkciu a predpony a používajú "
"rovnakú logiku porovnávania názvov ako Automerge."

#: dialogs.py:1055
msgid ""
"<b>Title duplicate search</b><br/>- Report books in this library compared to"
" your target library with a <b>soundex title</b> and {0}<br/>- Soundex title"
" matches are based on the same removal of punctuation and common prefixes as"
" a similar title search."
msgstr ""
"<b>Hľadanie duplikátov názvov</b><br/>- Nahlási knihy v tejto knižnici v "
"porovnaní s vašou cieľovou knižnicou s <b>názvom podľa soundexu</b> a "
"{0}<br/>- Zhody názvov podľa soundexu vychádzajú z rovnakého odstraňovania "
"interpunkcie a bežných predpôn ako hľadanie podobných názvov."

#: dialogs.py:1059
msgid ""
"<b>Title duplicate search</b><br/>- Report books in this library compared to"
" your target library with a <b>fuzzy title</b> and {0}<br/>- Fuzzy title "
"matches remove all punctuation, subtitles and any words after 'and', 'or' or"
" 'aka' in the title."
msgstr ""
"<b>Hľadanie duplikátov názvov</b><br/>- Nahlási knihy v tejto knižnici v "
"porovnaní s vašou cieľovou knižnicou s <b>približným názvom</b> a {0}<br/>- "
"Zhody približných názvov odstraňujú všetku interpunkciu, podtituly a všetky "
"slová po 'and', 'or' alebo 'aka' v názve."

#: dialogs.py:1063
msgid ""
"<b>Author duplicate search</b><br/>- Report books in this library compared "
"to your target library <b>ignoring title</b> with {0}<br/>- Ignore title "
"searches are best to find variations of author names regardless of the books"
" you have for each."
msgstr ""
"<b>Hľadanie duplikátov autorov</b><br/>- Nahlási knihy v tejto knižnici v "
"porovnaní s vašou cieľovou knižnicou <b>ignorujúc názov</b> s {0}<br/>- "
"Hľadania s ignorovaním názvu sú najlepšie na nájdenie variácií mien autorov "
"bez ohľadu na knihy, ktoré od nich máte."

