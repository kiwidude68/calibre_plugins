msgstr "Upravit klávesové zkratky přiřazené tomuto modulu"

#: config.py:1170
msgid "Reset &confirmation dialogs"
msgstr "Resetovat &potvrzovací dialogy"

#: config.py:1171
msgid "Reset all show me again dialogs for the Reading List plugin"
msgstr ""
"Resetovat všechny potvrzovací dialogy modulu Reading List skryté volbou "
"nezobrazovat znovu"

#: config.py:1175
msgid "&View library preferences"
msgstr "&Zobrazit předvolby knihovny"

#: config.py:1176
