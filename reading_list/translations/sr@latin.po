#: config.py:604
msgid "&Device to sync this list to:"
msgstr "&Uređaj sa kojim se sinhronizuje ova lista:"

#: config.py:605
msgid ""
"By specifying a device you can sync either manually or\n"
"automatically the contents of a list to that device.\n"
"This replaces the Book Sync plugin functionality"
msgstr ""
"Navođenjem uređaja možete ručno ili\n"
" automatski sinhronizovati sadržaj liste sa njim.\n"
" Time se zamenjuje funkcija dodatka Book Sync"

#: config.py:613
msgid "&When syncing this list:"
msgstr "&Pri sinhronizaciji ove liste:"

#: config.py:614
msgid ""
"Control how your items are synced to the device.\n"
"Sync only new items, sync all items overwriting existing\n"
"or use this list to just remove items from your device."
msgstr ""
"Odredite kako se stavke sinhronizuju sa uređajem.\n"
" Sinhronizujte samo nove stavke ili sve stavke uz zamenu postojećih,\n"
" odnosno koristite ovu listu samo za uklanjanje stavki sa uređaja."

#: config.py:622
msgid "Sync to this device as soon as it is connected"
msgstr "Sinhronizuj sa ovim uređajem čim se poveže"

#: config.py:623
msgid ""
"Uncheck this option if you prefer to manually sync to your device.\n"
"If no device is specified this checkbox has no effect"
msgstr ""
"Isključite ovu opciju ako želite da sinhronizujete uređaj ručno.\n"
" Ako uređaj nije naveden, ova opcija nema dejstva."

#: config.py:627
msgid "Clear this list after a sync to this device"
msgstr "Isprazni ovu listu posle sinhronizacije sa uređajem"

#: config.py:628
msgid ""
"If unchecked, only items not on the device already will be synced.\n"
"If no device is specified this checkbox has no effect.\n"
"This option can only be used with manual type lists."
msgstr ""
"Ako ova opcija nije izabrana, sinhronizovaće se samo stavke koje još nisu na uređaju.\n"
" Ako uređaj nije naveden, ova opcija nema dejstva.\n"
" Ova opcija može da se koristi samo sa listama koje se uređuju ručno."

