msgid "Allow toolbar button click to view list"
msgstr "Povoliť kliknutie na tlačidlo panela nástrojov na zobrazenie zoznamu"

#: config.py:1195
msgid ""
"By default the toolbar button shows the plugin menu.\n"
"Check this option to instead display a reading list."
msgstr ""
"Tlačidlo panela nástrojov predvolene zobrazuje ponuku zásuvného modulu.\n"
