msgid "Extract ISBN for %d books"
msgstr "Izdvoji ISBN za %d knjiga"

#: jobs.py:44
msgid "Extract ISBN started"
msgstr "Izdvajanje ISBN brojeva je započeto"

#: jobs.py:96
msgid "Scanned %d of %d"
msgstr "Skenirano %d od %d"

#: jobs.py:113
msgid "No formats"
msgstr "Nema dostupnih formata"

#: jobs.py:115
msgid "ISBN not found"
msgstr "ISBN nije pronađen"

#: jobs.py:121
msgid "Same ISBN"
msgstr "Isti ISBN"

