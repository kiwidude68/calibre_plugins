msgid "Queueing books for extracting ISBN"
msgstr "Dodajem knjige u red za izdvajanje ISBN brojeva"

#: dialogs.py:53
msgid "Queueing"
msgstr "Dodavanje u red"

#: dialogs.py:73
msgid "Extract ISBN failed"
msgstr "Izdvajanje ISBN brojeva nije uspelo"

#: dialogs.py:74
msgid "Scan aborted as no books with formats found."
msgstr "Skeniranje je prekinuto jer nisu pronađene knjige sa datotekama."

