#: ..\common\common_dialogs.py:112
msgid "Restart calibre now"
msgstr "Reštartovať calibre teraz"

#: ..\common\common_dialogs.py:128
msgid "Preferences for:"
msgstr "Nastavenia pre:"

#: ..\common\common_dialogs.py:160
msgid "Clear"
msgstr "Vymazať"

#: ..\common\common_dialogs.py:162
msgid "Clear all settings for this plugin"
msgstr "Vymazať všetky nastavenia tohto zásuvného modulu"

#: ..\common\common_dialogs.py:189
msgid ""
"Are you sure you want to change your settings in this library for this "
"plugin?"
msgstr ""
"Naozaj chcete zmeniť nastavenia tohto zásuvného modulu v tejto knižnici?"

#: ..\common\common_dialogs.py:190 ..\common\common_dialogs.py:210
msgid ""
"Any settings in other libraries or stored in a JSON file in your calibre "
"plugins folder will not be touched."
msgstr ""
"Nastavenia v iných knižniciach ani nastavenia uložené v súbore JSON v "
"priečinku zásuvných modulov calibre nebudú zmenené."

#: ..\common\common_dialogs.py:192 ..\common\common_dialogs.py:212
msgid "You must restart calibre afterwards."
msgstr "Potom musíte reštartovať calibre."

#: ..\common\common_dialogs.py:200
msgid "Settings changed"
msgstr "Nastavenia zmenené"

#: ..\common\common_dialogs.py:201
msgid "Settings for this plugin in this library have been changed."
msgstr "Nastavenia tohto zásuvného modulu v tejto knižnici boli zmenené."

#: ..\common\common_dialogs.py:202 ..\common\common_dialogs.py:223
msgid "Please restart calibre now."
msgstr "Teraz prosím reštartujte calibre."

#: ..\common\common_dialogs.py:209
msgid ""
"Are you sure you want to clear your settings in this library for this "
"plugin?"
msgstr ""
"Naozaj chcete vymazať nastavenia tohto zásuvného modulu v tejto knižnici?"

#: ..\common\common_dialogs.py:221
msgid "Settings deleted"
msgstr "Nastavenia vymazané"

#: ..\common\common_dialogs.py:222
msgid "All settings for this plugin in this library have been cleared."
msgstr ""
"Všetky nastavenia tohto zásuvného modulu v tejto knižnici boli vymazané."

#: ..\common\common_dialogs.py:297
msgid "Copy to clipboard"
msgstr "Kopírovať do schránky"

#: ..\common\common_widgets.py:105
msgid "Undefined"
msgstr "Nedefinované"

#: ..\common\common_widgets.py:160
msgid "Restart required"
msgstr "Vyžaduje sa reštart"

#: ..\common\common_widgets.py:161
msgid ""
"Title image not found - you must restart Calibre before using this plugin!"
msgstr ""
"Obrázok titulu sa nenašiel – pred použitím tohto zásuvného modulu musíte "
"reštartovať calibre!"

#: ..\common\common_widgets.py:234
msgid "Create new column"
msgstr "Vytvoriť nový stĺpec"

#: action.py:28
msgid "Extract ISBN from the selected book format"
msgstr "Extrahovať ISBN z vybraného formátu knihy"

#: action.py:28 action.py:74
msgid "Extract ISBN"
msgstr "Extrahovať ISBN"

#: action.py:43
msgid "No rows selected"
msgstr "Nie sú vybrané žiadne riadky"

#: action.py:44
msgid "You must select one or more books to perform this action."
msgstr "Ak chcete vykonať túto akciu, musíte vybrať jednu alebo viac kníh."

#: action.py:78
msgid "Extracting ISBN for {0} books"
msgstr "Extrahuje sa ISBN pre {0} kníh"

#: action.py:91
msgid "Failed to extract isbns"
msgstr "Extrahovanie ISBN zlyhalo"

#: action.py:94
msgid "ISBN extract completed"
msgstr "Extrahovanie ISBN dokončené"

#: action.py:99
msgid "Extract ISBN found <b>{0} new isbn(s)</b>."
msgstr "Extrahovanie ISBN našlo <b>{0} nových ISBN</b>."

#: action.py:100
msgid "Proceed with updating your library?"
msgstr "Pokračovať v aktualizácii knižnice?"

#: action.py:106
msgid ""
"Could not find an ISBN for {0} book(s) and {1} book(s) matched their "
"existing value."
msgstr ""
"Nepodarilo sa nájsť ISBN pre {0} kníh a {1} kníh sa zhodovalo s ich "
"existujúcou hodnotou."

#: action.py:109
msgid "Could not find an ISBN for {0} book(s)."
msgstr "Nepodarilo sa nájsť ISBN pre {0} kníh."

#: action.py:111
msgid "Found {0} book(s) where ISBN matched the existing value."
msgstr "Našlo sa {0} kníh, kde sa ISBN zhodovalo s existujúcou hodnotou."

#: action.py:113
msgid "Click \"Show details\" to see which books."
msgstr "Kliknutím na „Zobraziť podrobnosti“ zobrazíte, o ktoré knihy ide."

#: action.py:118
msgid "Scan failed"
msgstr "Skenovanie zlyhalo"

#: action.py:118 action.py:127
msgid "Scan log"
msgstr "Protokol skenovania"

#: action.py:127
msgid "Scan complete"
msgstr "Skenovanie dokončené"

#: action.py:153
msgid "Some books changed"
msgstr "Niektoré knihy sa zmenili"

#: action.py:154
msgid ""
"The metadata for some books in your library has changed since you started "
"the download. If you proceed, some of those changes may be overwritten. "
"Click \"Show details\" to see the list of changed books. Do you want to "
"proceed?"
msgstr ""
"Metadáta niektorých kníh vo vašej knižnici sa od spustenia sťahovania "
"zmenili. Ak budete pokračovať, niektoré z týchto zmien môžu byť prepísané. "
"Kliknutím na „Zobraziť podrobnosti“ zobrazíte zoznam zmenených kníh. Chcete "
"pokračovať?"

#: action.py:165 jobs.py:226
msgid "Unknown"
msgstr "Neznáme"

#: config.py:40
msgid "Do not change my search"
msgstr "Nemeniť moje vyhľadávanie"

#: config.py:41
msgid "Show the books that have new or updated ISBNs"
msgstr "Zobraziť knihy, ktoré majú nové alebo aktualizované ISBN"

#: config.py:71
msgid "When the scan completes:"
msgstr "Po dokončení skenovania:"

#: config.py:76
msgid "Valid prefixes for ISBN-13 (comma separated):"
msgstr "Platné predpony pre ISBN-13 (oddelené čiarkou):"

#: config.py:81
msgid "Selected books before running as a background job:"
msgstr "Vybrané knihy pred spustením ako úloha na pozadí:"

#: config.py:82
msgid "Running as a background job is slower but is the only way to avoid\n"
msgstr ""
"Spustenie ako úloha na pozadí je pomalšie, ale je to jediný spôsob, ako sa "
"vyhnúť\n"

#: config.py:83
msgid "memory leaks and will keep the UI more responsive."
msgstr "únikom pamäte, a používateľské rozhranie zostane responzívnejšie."

#: config.py:92
msgid "Batch size running as a background job:"
msgstr "Veľkosť dávky pri spustení ako úloha na pozadí:"

#: config.py:93
msgid ""
"Books will be broken into batches to ensure that if you run\n"
"extract for a large group you can cancel/close calibre without\n"
"losing all of your results as you can cancel the pending groups."
msgstr ""
"Knihy budú rozdelené do dávok, aby ste v prípade spustenia extrakcie\n"
"pre veľkú skupinu mohli zrušiť/zavrieť calibre bez straty všetkých\n"
"výsledkov, pretože môžete zrušiť čakajúce skupiny."

#: config.py:105
msgid "Display failure dialog if ISBN not found or identical"
msgstr "Zobraziť dialóg zlyhania, ak sa ISBN nenájde alebo je rovnaké"

#: config.py:106
msgid ""
"Uncheck this option if you want do not want to be prompted\n"
"about no ISBN being found in the book or it is the same as\n"
"your current value."
msgstr ""
"Odčiarknite túto možnosť, ak nechcete byť upozornení na to, že sa v knihe\n"
"nenašlo žiadne ISBN alebo že je rovnaké ako vaša aktuálna hodnota."

#: config.py:113
msgid "Prompt to apply ISBN changes"
msgstr "Zobraziť výzvu na použitie zmien ISBN"

#: config.py:114
msgid ""
"Uncheck this option if you want changes applied without\n"
"a confirmation dialog. There is a small risk with this\n"
"option unchecked that if you are making other changes to\n"
"this book record at the same time they will be lost."
msgstr ""
"Odčiarknite túto možnosť, ak chcete zmeny použiť bez potvrdzovacieho\n"
"dialógu. Pri odčiarknutej možnosti existuje malé riziko, že ak v tom\n"
"istom čase vykonávate iné zmeny tohto záznamu knihy, budú stratené."

#: config.py:123
msgid "Edit the keyboard shortcuts associated with this plugin"
msgstr "Upraviť klávesové skratky priradené tomuto zásuvnému modulu"

#: config.py:127
msgid "Help"
msgstr "Pomocník"

#: dialogs.py:25
msgid "Queueing books for extracting ISBN"
msgstr "Zaraďovanie kníh do frontu na extrakciu ISBN"

#: dialogs.py:53
msgid "Queueing"
msgstr "Zaraďovanie do frontu"

#: dialogs.py:73
msgid "Extract ISBN failed"
msgstr "Extrahovanie ISBN zlyhalo"

#: dialogs.py:74
msgid "Scan aborted as no books with formats found."
msgstr "Skenovanie prerušené, pretože sa nenašli žiadne knihy s formátmi."

#: jobs.py:41
msgid "Extract ISBN for %d books"
msgstr "Extrahovať ISBN pre %d kníh"

#: jobs.py:44
msgid "Extract ISBN started"
msgstr "Extrahovanie ISBN spustené"

#: jobs.py:96
msgid "Scanned %d of %d"
msgstr "Naskenovaných %d z %d"

#: jobs.py:113
msgid "No formats"
msgstr "Žiadne formáty"

#: jobs.py:115
msgid "ISBN not found"
msgstr "ISBN sa nenašlo"

#: jobs.py:121
msgid "Same ISBN"
msgstr "Rovnaké ISBN"

#: jobs.py:127
msgid "Extracted"
msgstr "Extrahované"
