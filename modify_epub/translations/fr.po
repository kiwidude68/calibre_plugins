msgstr "Redémarrage nécessaire"

#: ..\common\common_widgets.py:161
msgid ""
"Title image not found - you must restart Calibre before using this plugin!"
msgstr ""
"L'image d'icone n'a pas était trouvée - vous devez redémarrer Calibre avant "
"d'utiliser ce plugin !"

#: ..\common\common_widgets.py:234
msgid "Create new column"
msgstr "Créer une nouvelle colonne"

#: action.py:35
msgid "Modify the contents of an ePub without a conversion"
msgstr "Modifier le contenu d'un fichier ePub sans conversion"

#: action.py:35 dialogs.py:100
msgid "Modify ePub"
msgstr "Modifier un fichier ePub"

#: action.py:47 action.py:58
msgid "Cannot modify ePub"
msgstr "Impossible de modifier le fichier ePub"

#: action.py:48
msgid "You must select one or more books to perform this action."
msgstr ""
"Vous devez sélectionner un ou plusieurs livres pour exécuter cette action"

#: action.py:59
msgid "No ePub available. First convert the book to ePub."
msgstr ""
"Aucun fichier ePub n'est disponible. Commencez par convertir le livre au "
"format ePub."

#: action.py:88
msgid "Failed to modify ePubs"
msgstr "Échec de la modification des fichiers ePub"

#: action.py:91
msgid "Modify ePub completed"
msgstr "Modification du fichier ePub terminée"

#: action.py:95
msgid ""
"No ePub files were updated. If this isn't what you expected then press the "
"Show details button to check for errors in the log."
msgstr ""
"Aucun fichier ePub n'a été mis à jour. Si ce n'est pas ce à quoi vous vous "
"attendiez, cliquez sur le bouton « Afficher les détails » pour vérifier s'il"
" y a des erreurs dans le journal."

#: action.py:97
msgid "Modify ePub changed no files"
msgstr "Modification du fichier ePub n'a modifié aucun fichier"

#: action.py:105
msgid ""
"Modify ePub modified <b>%d ePub files(s)</b> into a temporary location. "
"Proceed with replacing the versions in your library?"
msgstr ""
"Modifie les fichiers ePub a modifié <b>%d fichier(s) ePub dans un "
"emplacement temporaire. Voulez-vous remplacer les versions présentes dans "
"votre bibliothèque ?"

#: action.py:110
msgid "Modify ePub complete"
msgstr "Modification du fichier ePub terminée"

#: action.py:110
msgid "Modify log"
msgstr "Modifie le journal"

#: config.py:52
msgid "Other options:"
msgstr "Autres options :"

#: config.py:57
msgid "Prompt to save epubs"
msgstr "Demande pour enregistrer les fichiers ePub"

#: config.py:58
msgid ""
"Uncheck this option if you want changes applied without a confirmation "
"dialog."
msgstr ""
"Décochez cette option si vous souhaitez que les modifications soient "
"appliquées sans boîte de dialogue de confirmation."

#: config.py:64
msgid "Edit the keyboard shortcuts associated with this plugin"
msgstr "Modifier les raccourcis clavier associés à cette extension"

#: config.py:68
msgid "&Help"
msgstr "&Aide"

#: dialogs.py:36
msgid "Remove iTunes files"
msgstr "Supprime les fichiers iTunes"

#: dialogs.py:36
msgid ""
"Removes any iTunesMetadata.plist or artwork files\n"
"added by viewing the ePub in iTunes"
msgstr ""
"Supprime tous les fichiers « iTunesMetadata.plist » ou les fichiers d'illustrations\n"
"ajoutés lors de la consultation du fichier ePub dans iTunes"

#: dialogs.py:37
msgid "Remove any bookmark files added by the calibre ebook viewer"
msgstr ""
"Supprime tous les fichiers de signets ajoutés par la visionneuse de livres "
"Calibre"

#: dialogs.py:37
msgid "Remove calibre bookmark files"
msgstr "Supprime les fichiers de signets de Calibre"

#: dialogs.py:38
msgid "Remove OS artifact files"
msgstr "Supprime les fichiers résiduels de l'OS"

#: dialogs.py:38
msgid ""
"Removes any OS artifacts like thumbs.db or .DS_Store\n"
"that are not needed by the ePub"
msgstr ""
"Supprime tous les fichiers résiduels de l'OS, tels que « thumbs.db » ou « .DS_Store »,\n"
"qui ne sont pas nécessaires au format ePub"

#: dialogs.py:39
msgid ""
"Remove any unused jpg, png or gif image files that are not referenced\n"
"from the html pages. This can occur as the result of careless ePub editing."
msgstr ""
"Supprime tous les fichiers jpg, png ou gif inutilisés qui ne sont pas référencés\n"
"dans les pages HTML. Cela peut être dû à une édition négligente du fichier ePub."

#: dialogs.py:39
msgid "Remove unused image files"
msgstr "Supprime les fichiers image inutilisé"

#: dialogs.py:40
msgid "De-indent (aka unpretty)"
msgstr "Supprime l'indentation (ou « vilaine »)"

#: dialogs.py:40
msgid "Remove indentation from HTML files"
msgstr "Supprime l'indentations des fichiers HTML"

#: dialogs.py:41
msgid "Remove remnants of Kobo DRM"
msgstr "Supprime les traces du DRM de Kobo"

#: dialogs.py:41
msgid "Strip Kobo DRM remnants"
msgstr "Portéed des traces du DRM de Kobo"

#: dialogs.py:42
msgid "Remove spans without attributes"
msgstr "Supprime les segments sans attributs"

#: dialogs.py:42
msgid "Strip spans"
msgstr "Portées des bandes"

#: dialogs.py:46
msgid ""
"Remove entries in the manifest for files listed that do not exist in the "
"ePub"
msgstr ""
"Supprime les entrées du manifeste des fichiers répertoriés qui n'existent "
"pas dans le fichier ePub"

#: dialogs.py:46
msgid "Remove missing file entries from manifest"
msgstr "Supprime les entrées de fichiers manquantes du manifeste"

#: dialogs.py:47
msgid ""
"Add files to manifest that are in the ePub but do not exist in the .opf manifest\n"
"(excluding iTunes/calibre bookmarks)"
msgstr ""
"Ajouter au manifeste les fichiers présents dans le fichier ePub mais qui n'existent pas dans le manifeste .opf\n"
"(à l'exception des signets iTunes/Calibre)"

#: dialogs.py:47
msgid "Add unmanifested files to manifest"
msgstr "Ajouter les fichiers non répertoriés dans le manifeste"

#: dialogs.py:48
msgid ""
"Remove files from the ePub that do not exist in the .opf manifest\n"
"(excluding iTunes/calibre bookmarks). Will not be applied if the add option is also checked"
msgstr ""
"Supprime du ePub les fichiers qui n'existent pas dans le manifeste .opf\n"
"(à l'exception des signets iTunes/calibre). Ceci ne sera pas appliqué si l'option « Ajouter » est également cochée."

#: dialogs.py:48
msgid "Remove unmanifested files from ePub"
msgstr "Supprime les fichiers non déclarés de l'ePub"

#: dialogs.py:52
msgid ""
"Remove any Adobe .xpgt file margins to prevent them\n"
"interfering with viewing"
msgstr ""
"Supprime les marges des fichiers .xpgt d'Adobe afin qu'elles\n"
"n'entravent pas la visualisation"

#: dialogs.py:52
msgid "Remove margins from Adobe .xpgt files"
msgstr "Supprime les marges des fichiers .xpgt d'Adobe"

#: dialogs.py:53
msgid ""
"Delete the .xpgt file completely from the epub\n"
"as well as removing any links from the xhtml files"
msgstr ""
"Supprime complètement le fichier .xpgt de l'epub\n"
"et supprimez également tous les liens présents dans les fichiers xhtml"

#: dialogs.py:53
msgid "Remove Adobe .xpgt files and links"
msgstr "Supprimer les fichiers et les liens Adobe .xpgt"

#: dialogs.py:54
msgid "Remove Adobe resource DRM meta tags"
msgstr "Supprimer les méta balises des ressource Adobe DRM "

#: dialogs.py:54
msgid ""
"Remove any meta tags from the xhtml files that\n"
"contain DRM urn identifiers."
msgstr ""
"Supprimer toutes les meta balises des fichiers XHTML qui\n"
"contiennent des identifiants URN DRM."

#: dialogs.py:55
msgid "Remove page maps"
msgstr "Supprimer les mappages"

#: dialogs.py:55
msgid "Removes all types of page map files"
msgstr "Supprime tous les types de fichiers de mappage"

#: dialogs.py:56
msgid "Remove ONLY Google Play page maps"
msgstr "Supprimer UNIQUEMENT les mappages Google Play"

#: dialogs.py:56
msgid "Removes only Google Play page map files"
msgstr "Supprime uniquement les fichiers de mappages Google Play"

#: dialogs.py:60
msgid "Flatten TOC hierarchy in NCX file"
msgstr "Aplanir la hiérarchie de la table des matières dans un fichier NCX"

#: dialogs.py:60
msgid ""
"Restructure the NCX to contain no nesting of navPoint items.\n"
"For users whose devices do not support a hierarchical TOC."
msgstr ""
"Réorganiser le NCX de manière à ce qu'il ne contienne aucun élément navPoint imbriqué.\n"
"Pour les utilisateurs dont les appareils ne prennent pas en charge une table des matières hiérarchique."

#: dialogs.py:61
msgid ""
"Any NCX entries that point to missing html pages will be removed.\n"
"Orphaned NCX links can happen as a result of a calibre conversion for covers."
msgstr ""
"Toutes les entrées NCX renvoyant vers des pages HTML manquantes seront supprimées.\n"
"Des liens NCX orphelins peuvent apparaître à la suite d'une conversion Calibre des couvertures."

#: dialogs.py:61
msgid "Remove broken TOC entries in NCX file"
msgstr "Supprimer les entrées TOC erronées dans le fichier NCX"

#: dialogs.py:65
msgid "Remove all calibre jackets, both legacy and current"
msgstr "Supprimer toutes les jaquettes Calibre, obsolètes et actuelles"

#: dialogs.py:65
msgid "Remove all metadata jackets"
msgstr "Supprimer toutes les fiches de métadonnées des jaquettes"

#: dialogs.py:66
msgid "Remove jackets generated using versions of calibre prior to 0.6.50"
msgstr ""
"Supprimer les jaquettes générées avec des versions de Calibre antérieures à "
"la version 0.6.50"

#: dialogs.py:66
msgid "Remove legacy metadata jackets"
msgstr "Supprimer les métadonnées des jaquettes obsolètes"

#: dialogs.py:67
msgid "Add a jacket if not existing, or replace a non-legacy jacket"
msgstr ""
"Ajouter une jaquette si elle n'existe pas, ou remplacer une jaquette non-"
"obsolète"

#: dialogs.py:67
msgid "Add/replace metadata jacket"
msgstr "Ajouter/remplacer les métadonnées de la jaquette"

#: dialogs.py:68
msgid ""
"If a jacket is added/replaced, it is placed at the end of the book instead "
"of the beginning"
msgstr ""
"Si une jaquette est ajoutée ou remplacée, elle est placée à la fin du livre "
"plutôt qu'au début."

#: dialogs.py:68
msgid "Jacket at the end of the book"
msgstr "Jaquette à la fin du livre"

#: dialogs.py:72
msgid "Remove broken image pages"
msgstr "Supprimer les pages contenant des images endommagées"

#: dialogs.py:72
msgid ""
"Remove html page(s) that contain only an image tag for which\n"
"the linked image does not exist in the epub"
msgstr ""
"Supprimer la ou les page(s) HTML qui ne contiennent qu'une balise d'image pour laquelle\n"
"l'image associée n'existe pas dans le fichier ePub"

#: dialogs.py:73
msgid ""
"If a cover page is identifiable in the epub then it is completely removed"
msgstr ""
"Si une page de garde est détectée dans le fichier ePub, elle est alors "
"entièrement supprimée."

#: dialogs.py:73
msgid "Remove existing cover"
msgstr "Retirer la couverture existante"

#: dialogs.py:74
msgid ""
"If a cover page is identifiable in the epub then it is replaced\n"
"otherwise a new cover page is inserted"
msgstr ""
"Si une page de garde est identifiable dans le fichier ePub, elle est remplacée ;\n"
"sinon, une nouvelle page de garde est insérée."

#: dialogs.py:74
msgid "Insert or replace cover"
msgstr "Insérer ou remplacer la couverture"

#: dialogs.py:78
msgid "Update metadata"
msgstr "Mettre à jour les métadonnées"

#: dialogs.py:78
msgid ""
"Update the manifest with the latest calibre metadata\n"
"and replace an existing identifiable cover if possible."
msgstr ""
"Mettez à jour le manifeste avec les dernières métadonnées de Calibre\n"
"et remplacez, si possible, une couverture existante identifiable."

#: dialogs.py:79
msgid ""
"Remove any metadata from the .opf manifest that is not in the dc: namespace.\n"
"Such entries are created by editing in Sigil or calibre updating metadata.\n"
"Use this option if publishing your ePubs externally."
msgstr ""
"Supprimez toutes les métadonnées du manifeste .opf qui ne se trouvent pas dans le domaine de nom dc: \n"
"Ces entrées sont créées lors de la modification dans Sigil ou lors de la mise à jour des métadonnées dans Calibre.\n"
"Utilisez cette option si vous publiez vos fichiers ePub en externe."

#: dialogs.py:79
msgid "Remove non dc: metadata elements"
msgstr "Supprimer les éléments de métadonnées non « dc: »"

#: dialogs.py:83
msgid "Encode HTML in UTF-8"
msgstr "Encoder le code HTML en UTF-8"

#: dialogs.py:83
msgid ""
"Removes any existing <meta> charset tags on html pages and encodes in UTF-8.\n"
"For use where ebook does not display quotes in calibre viewer correctly."
msgstr ""
"Supprime toutes les <meta> balises de jeu de caractères existantes sur les pages HTML et encode le contenu en UTF-8.\n"
"À utiliser lorsque le livre électronique n'affiche pas correctement les guillemets dans la visionneuse Calibre."

#: dialogs.py:84
msgid "Remove embedded fonts"
msgstr "Supprimer les polices intégrées"

#: dialogs.py:84
msgid ""
"Remove embedded fonts from the manifest and their files to reduce ePub size.\n"
"Also removes @font-face declarations."
msgstr ""
"Supprime les polices intégrées du manifeste et leurs fichiers afin de réduire la taille du fichier ePub.\n"
"Supprime également les déclarations @font-face."

#: dialogs.py:85
msgid "Modify @page and body margin styles"
msgstr "Modifier les styles de marge de la @page et du corps du texte"

#: dialogs.py:85
msgid ""
"Replace margin styles for @page or body with your calibre defaults in a new @page style.\n"
"If your calibre defaults are negative, removes the margin attributes and if necessary the CSS file."
msgstr ""
"Remplacez les styles de marge pour la @page ou le corps par vos valeurs par défaut de Calibre dans un nouveau style @page.\n"
"Si vos valeurs par défaut de Calibre sont négatives, supprime les attributs de marge, et si nécessaire, le fichier CSS."

#: dialogs.py:86
msgid "Append extra CSS"
msgstr "Ajouter du code CSS supplémentaire"

#: dialogs.py:86
msgid ""
"Appends any Extra CSS you have defined in your calibre defaults to every .CSS file.\n"
"If you have no extra CSS defined or text already contained then it does nothing."
msgstr ""
"Ajoute tout code CSS supplémentaire que vous avez défini dans vos paramètres par défaut de Calibre à chaque fichier .CSS.\n"
"Si vous n'avez défini aucun code CSS supplémentaire ou si le fichier contient pas déjà du texte, cette fonction ne fait rien."

#: dialogs.py:87
msgid "Convert html to use smart quotes and emdash characters"
msgstr ""
"Convertir l'HTML pour utiliser des guillemets typographiques et des "
"caractères tirets longs"

#: dialogs.py:87
msgid "Smarten punctuation"
msgstr "Optimiser la ponctuation"

#: dialogs.py:88
msgid "Remove any .js files and inline javascript blocks"
msgstr ""
"Supprimez tous les fichiers .js et les blocs de code JavaScript intégrés"

#: dialogs.py:88
msgid "Remove inline javascript and files"
msgstr "Supprimer le code JavaScript intégré et les fichiers"

#: dialogs.py:103
msgid "Modify ePub Options"
msgstr "Modifier les options ePub"

#: dialogs.py:128
msgid "Known Artifacts"
msgstr "Known Artifacts"

#: dialogs.py:129
msgid "Manifest"
msgstr "Manifeste"

#: dialogs.py:130
msgid "Adobe"
msgstr "Adobe"

#: dialogs.py:131
msgid "Table of Contents"
msgstr "Table des matières"

#: dialogs.py:133
msgid "HTML && Styles"
msgstr "HTML && Styles"

#: dialogs.py:134
msgid "Metadata Jackets"
msgstr "Métadonnées des jaquettes"

#: dialogs.py:135
msgid "Covers"
msgstr "Couvertures"

#: dialogs.py:136
msgid "Metadata"
msgstr "Métadonnée"

#: dialogs.py:142
msgid "Clear all"
msgstr "Tout effacer"

#: dialogs.py:143
msgid "Clear all selections"
msgstr "Effacer toutes les sélections"

#: dialogs.py:145
msgid "Save"
msgstr "Sauvegarder"

#: dialogs.py:146
msgid ""
"Save the current selected settings for future recall with the Restore button"
msgstr ""
"Enregistrez les paramètres actuellement sélectionnés pour pouvoir les "
"réutiliser ultérieurement à l'aide du bouton « Restaurer »"

#: dialogs.py:148
msgid "Restore"
msgstr "Restaurer"

#: dialogs.py:149
msgid "Restore your settings set when the Save button was last clicked"
msgstr ""
"Restaurer les paramètres définis lors du dernier clic sur le bouton « "
"Enregistrer »"

#: dialogs.py:179
msgid "No options selected"
msgstr "Aucune option sélectionnée"

#: dialogs.py:180
msgid "You must select at least one option to continue"
msgstr "Vous devez sélectionner au moins une option pour continuer"

#: dialogs.py:206 dialogs.py:275
msgid "Cancel"
msgstr "Annuler"

#: dialogs.py:206 dialogs.py:275
msgid "Working"
msgstr "En travail"

#: dialogs.py:207
msgid "Queueing books for modifying ePubs"
msgstr "Mise en file d'attente des livres en vue de la modification des ePub"

#: dialogs.py:223
msgid "Queueing"
msgstr "Mise en file d'attente"

#: dialogs.py:255
msgid "Could not modify ePub for some books"
msgstr "Impossible de modifier l'ePub pour certains livres"

#: dialogs.py:256
msgid ""
"Could not modify %d of %d books, because no ePub source format was found."
msgstr ""
"Impossible de modifier %d de %d livres , car aucun format source ePub n'a "
"été trouvé."

#: dialogs.py:276
msgid "Adding %d modified ePubs"
msgstr "Ajout de %d ePub modifiés"

#: dialogs.py:297
msgid "Adding"
msgstr "Ajouter"

#: dialogs.py:312
msgid "ePub files updated"
msgstr "Fichiers ePub mis à jour"
