msgstr ""
"Les paramètres pour ce plugin dans cette bibliothèque ont été modifiés."

#: ..\common\common_dialogs.py:202 ..\common\common_dialogs.py:223
msgid "Please restart calibre now."
msgstr "Merci de redémarrer calibre maintenant."

