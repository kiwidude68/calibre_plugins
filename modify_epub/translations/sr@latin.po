msgstr "Obriši sva podešavanja ovog dodatka"

#: ..\common\common_dialogs.py:189
msgid ""
"Are you sure you want to change your settings in this library for this "
"plugin?"
msgstr ""
"Da li ste sigurni da želite da promenite podešavanja ovog dodatka u ovoj "
"biblioteci?"

#: ..\common\common_dialogs.py:190 ..\common\common_dialogs.py:210
msgid ""
"Any settings in other libraries or stored in a JSON file in your calibre "
"plugins folder will not be touched."
msgstr ""
"Podešavanja u drugim bibliotekama, kao ni ona sačuvana u JSON datoteci u "
"fascikli dodataka za calibre, neće biti promenjena."

#: ..\common\common_dialogs.py:192 ..\common\common_dialogs.py:212
msgid "You must restart calibre afterwards."
msgstr "Nakon toga morate ponovo pokrenuti calibre."

#: ..\common\common_dialogs.py:200
msgid "Settings changed"
msgstr "Podešavanja su promenjena"

#: ..\common\common_dialogs.py:201
msgid "Settings for this plugin in this library have been changed."
msgstr "Podešavanja ovog dodatka u ovoj biblioteci su promenjena."

#: ..\common\common_dialogs.py:202 ..\common\common_dialogs.py:223
msgid "Please restart calibre now."
msgstr "Ponovo pokrenite calibre sada."

#: ..\common\common_dialogs.py:209
msgid ""
"Are you sure you want to clear your settings in this library for this "
"plugin?"
msgstr ""
"Da li ste sigurni da želite da obrišete podešavanja ovog dodatka u ovoj "
"biblioteci?"

#: ..\common\common_dialogs.py:221
msgid "Settings deleted"
msgstr "Podešavanja su obrisana"

#: ..\common\common_dialogs.py:222
msgid "All settings for this plugin in this library have been cleared."
msgstr "Sva podešavanja ovog dodatka u ovoj biblioteci su obrisana."

#: ..\common\common_dialogs.py:297
msgid "Copy to clipboard"
msgstr "Kopiraj u privremenu memoriju"

#: ..\common\common_widgets.py:105
msgid "Undefined"
msgstr "Nedefinisano"

#: ..\common\common_widgets.py:160
msgid "Restart required"
msgstr "Potrebno je ponovno pokretanje"

#: ..\common\common_widgets.py:161
msgid ""
"Title image not found - you must restart Calibre before using this plugin!"
msgstr ""
"Slika naslova nije pronađena — morate ponovo pokrenuti calibre pre "
"korišćenja ovog dodatka!"

#: ..\common\common_widgets.py:234
msgid "Create new column"
msgstr "Napravi novu kolonu"

#: action.py:35
msgid "Modify the contents of an ePub without a conversion"
msgstr "Izmeni sadržaj ePub knjige bez konverzije"

#: action.py:35 dialogs.py:100
msgid "Modify ePub"
msgstr "Izmeni ePub"

#: action.py:47 action.py:58
msgid "Cannot modify ePub"
msgstr "Nije moguće izmeniti ePub"

#: action.py:48
msgid "You must select one or more books to perform this action."
msgstr "Morate izabrati jednu ili više knjiga da biste izvršili ovu radnju."

#: action.py:59
msgid "No ePub available. First convert the book to ePub."
msgstr "ePub format nije dostupan. Najpre pretvorite knjigu u ePub."

#: action.py:88
msgid "Failed to modify ePubs"
msgstr "Izmena ePub datoteka nije uspela"

#: action.py:91
msgid "Modify ePub completed"
msgstr "Izmena ePub datoteka je završena"

#: action.py:95
msgid ""
"No ePub files were updated. If this isn't what you expected then press the "
"Show details button to check for errors in the log."
msgstr ""
"Nijedna ePub datoteka nije ažurirana. Ako to niste očekivali, kliknite na "
"dugme „Prikaži detalje“ da proverite greške u dnevniku."

#: action.py:97
msgid "Modify ePub changed no files"
msgstr "Dodatak Modify ePub nije izmenio nijednu datoteku"

#: action.py:105
msgid ""
"Modify ePub modified <b>%d ePub files(s)</b> into a temporary location. "
"Proceed with replacing the versions in your library?"
msgstr ""
"Dodatak Modify ePub izmenio je <b>%d ePub datoteka</b> na privremenoj "
"lokaciji. Da li želite da njima zamenite verzije u biblioteci?"

#: action.py:110
msgid "Modify ePub complete"
msgstr "Izmena ePub datoteka je završena"

#: action.py:110
msgid "Modify log"
msgstr "Dnevnik izmena"

#: config.py:52
msgid "Other options:"
msgstr "Ostale opcije:"

#: config.py:57
msgid "Prompt to save epubs"
msgstr "Traži potvrdu pre čuvanja ePub datoteka"

#: config.py:58
msgid ""
"Uncheck this option if you want changes applied without a confirmation "
"dialog."
msgstr ""
"Isključite ovu opciju ako želite da se izmene primene bez dijaloga za "
"potvrdu."

#: config.py:64
msgid "Edit the keyboard shortcuts associated with this plugin"
msgstr "Izmeni prečice na tastaturi za ovaj dodatak"

#: config.py:68
msgid "&Help"
msgstr "&Pomoć"

#: dialogs.py:36
msgid "Remove iTunes files"
msgstr "Ukloni iTunes datoteke"

#: dialogs.py:36
msgid ""
"Removes any iTunesMetadata.plist or artwork files\n"
"added by viewing the ePub in iTunes"
msgstr ""
"Uklanja iTunesMetadata.plist i datoteke ilustracija\n"
"dodate pri prikazivanju ePub knjige u iTunes-u"

#: dialogs.py:37
msgid "Remove any bookmark files added by the calibre ebook viewer"
msgstr "Ukloni datoteke obeleživača koje je dodao čitač e-knjiga u calibre-u"

#: dialogs.py:37
msgid "Remove calibre bookmark files"
msgstr "Ukloni calibre datoteke obeleživača"

#: dialogs.py:38
msgid "Remove OS artifact files"
msgstr "Ukloni sistemske pomoćne datoteke"

#: dialogs.py:38
msgid ""
"Removes any OS artifacts like thumbs.db or .DS_Store\n"
"that are not needed by the ePub"
msgstr ""
"Uklanja sistemske pomoćne datoteke, kao što su thumbs.db i .DS_Store,\n"
"koje ePub knjizi nisu potrebne"

#: dialogs.py:39
msgid ""
"Remove any unused jpg, png or gif image files that are not referenced\n"
"from the html pages. This can occur as the result of careless ePub editing."
msgstr ""
"Uklanja nekorišćene jpg, png ili gif slike na koje se ne upućuje\n"
"sa HTML stranica. Takve datoteke mogu ostati posle nepažljivog uređivanja ePub knjige."

#: dialogs.py:39
msgid "Remove unused image files"
msgstr "Ukloni nekorišćene slike"

#: dialogs.py:40
msgid "De-indent (aka unpretty)"
msgstr "Ukloni uvlačenja (sažmi kod)"

#: dialogs.py:40
msgid "Remove indentation from HTML files"
msgstr "Ukloni uvlačenja iz HTML datoteka"

#: dialogs.py:41
msgid "Remove remnants of Kobo DRM"
msgstr "Ukloni ostatke Kobo DRM zaštite"

#: dialogs.py:41
msgid "Strip Kobo DRM remnants"
msgstr "Ukloni ostatke Kobo DRM zaštite"

#: dialogs.py:42
msgid "Remove spans without attributes"
msgstr "Ukloni span elemente bez atributa"

#: dialogs.py:42
msgid "Strip spans"
msgstr "Ukloni span elemente"

#: dialogs.py:46
msgid ""
"Remove entries in the manifest for files listed that do not exist in the "
"ePub"
msgstr "Ukloni iz manifesta zapise o datotekama koje ne postoje u ePub knjizi"

#: dialogs.py:46
msgid "Remove missing file entries from manifest"
msgstr "Ukloni iz manifesta zapise o datotekama koje nedostaju"

#: dialogs.py:47
msgid ""
"Add files to manifest that are in the ePub but do not exist in the .opf manifest\n"
"(excluding iTunes/calibre bookmarks)"
msgstr ""
"Dodaj u manifest datoteke koje postoje u ePub knjizi, ali ih nema u .opf manifestu\n"
"(osim iTunes/calibre obeleživača)"

#: dialogs.py:47
msgid "Add unmanifested files to manifest"
msgstr "Dodaj u manifest datoteke koje nisu navedene"

#: dialogs.py:48
msgid ""
"Remove files from the ePub that do not exist in the .opf manifest\n"
"(excluding iTunes/calibre bookmarks). Will not be applied if the add option is also checked"
msgstr ""
"Ukloni iz ePub knjige datoteke koje nisu navedene u .opf manifestu\n"
"(osim iTunes/calibre obeleživača). Ne primenjuje se ako je uključeno i dodavanje u manifest"

#: dialogs.py:48
msgid "Remove unmanifested files from ePub"
msgstr "Ukloni iz ePub knjige datoteke koje nisu navedene u manifestu"

#: dialogs.py:52
msgid ""
"Remove any Adobe .xpgt file margins to prevent them\n"
"interfering with viewing"
msgstr ""
"Ukloni margine iz Adobe .xpgt datoteka da ne bi\n"
"ometale prikaz"

#: dialogs.py:52
msgid "Remove margins from Adobe .xpgt files"
msgstr "Ukloni margine iz Adobe .xpgt datoteka"

#: dialogs.py:53
msgid ""
"Delete the .xpgt file completely from the epub\n"
"as well as removing any links from the xhtml files"
msgstr ""
"Potpuno obriši .xpgt datoteku iz ePub knjige\n"
"i ukloni sve veze ka njoj iz XHTML datoteka"

#: dialogs.py:53
msgid "Remove Adobe .xpgt files and links"
msgstr "Ukloni Adobe .xpgt datoteke i veze"

#: dialogs.py:54
msgid "Remove Adobe resource DRM meta tags"
msgstr "Ukloni Adobe DRM meta-oznake resursa"

#: dialogs.py:54
msgid ""
"Remove any meta tags from the xhtml files that\n"
"contain DRM urn identifiers."
msgstr ""
"Ukloni iz XHTML datoteka sve meta-oznake koje\n"
"sadrže DRM URN identifikatore."

#: dialogs.py:55
msgid "Remove page maps"
msgstr "Ukloni mape stranica"

#: dialogs.py:55
msgid "Removes all types of page map files"
msgstr "Uklanja sve vrste datoteka sa mapama stranica"

#: dialogs.py:56
msgid "Remove ONLY Google Play page maps"
msgstr "Ukloni SAMO Google Play mape stranica"

#: dialogs.py:56
msgid "Removes only Google Play page map files"
msgstr "Uklanja samo datoteke sa Google Play mapama stranica"

#: dialogs.py:60
msgid "Flatten TOC hierarchy in NCX file"
msgstr "Ukloni hijerarhiju sadržaja iz NCX datoteke"

#: dialogs.py:60
msgid ""
"Restructure the NCX to contain no nesting of navPoint items.\n"
"For users whose devices do not support a hierarchical TOC."
msgstr ""
"Preuredi NCX tako da stavke navPoint ne budu ugnježđene.\n"
"Za uređaje koji ne podržavaju hijerarhijski sadržaj."

#: dialogs.py:61
msgid ""
"Any NCX entries that point to missing html pages will be removed.\n"
"Orphaned NCX links can happen as a result of a calibre conversion for covers."
msgstr ""
"NCX stavke koje upućuju na HTML stranice koje nedostaju biće uklonjene.\n"
"Nepovezane NCX veze mogu nastati posle calibre konverzije korica."

#: dialogs.py:61
msgid "Remove broken TOC entries in NCX file"
msgstr "Ukloni neispravne stavke sadržaja iz NCX datoteke"

#: dialogs.py:65
msgid "Remove all calibre jackets, both legacy and current"
msgstr "Ukloni sve calibre stranice sa metapodacima, stare i nove"

#: dialogs.py:65
msgid "Remove all metadata jackets"
msgstr "Ukloni sve stranice sa metapodacima"

#: dialogs.py:66
msgid "Remove jackets generated using versions of calibre prior to 0.6.50"
msgstr ""
"Ukloni stranice sa metapodacima napravljene u verzijama calibre-a pre 0.6.50"

#: dialogs.py:66
msgid "Remove legacy metadata jackets"
msgstr "Ukloni stare stranice sa metapodacima"

#: dialogs.py:67
msgid "Add a jacket if not existing, or replace a non-legacy jacket"
msgstr ""
"Dodaj stranicu sa metapodacima ako ne postoji ili zameni postojeću koja nije"
" stara"

#: dialogs.py:67
msgid "Add/replace metadata jacket"
msgstr "Dodaj/zameni stranicu sa metapodacima"

#: dialogs.py:68
msgid ""
"If a jacket is added/replaced, it is placed at the end of the book instead "
"of the beginning"
msgstr ""
"Ako se stranica sa metapodacima doda ili zameni, biće postavljena na kraj "
"knjige, a ne na početak"

#: dialogs.py:68
msgid "Jacket at the end of the book"
msgstr "Postavi stranicu sa metapodacima na kraj knjige"

#: dialogs.py:72
msgid "Remove broken image pages"
msgstr "Ukloni stranice sa neispravnim slikama"

#: dialogs.py:72
msgid ""
"Remove html page(s) that contain only an image tag for which\n"
"the linked image does not exist in the epub"
msgstr ""
"Ukloni HTML stranice koje sadrže samo oznaku za sliku\n"
"ako povezana slika ne postoji u ePub knjizi"

#: dialogs.py:73
msgid ""
"If a cover page is identifiable in the epub then it is completely removed"
msgstr ""
"Ako je moguće prepoznati stranicu korica u ePub knjizi, ona će biti potpuno "
"uklonjena"

#: dialogs.py:73
msgid "Remove existing cover"
msgstr "Ukloni postojeće korice"

#: dialogs.py:74
msgid ""
"If a cover page is identifiable in the epub then it is replaced\n"
"otherwise a new cover page is inserted"
msgstr ""
"Ako je moguće prepoznati stranicu korica u ePub knjizi, ona će biti zamenjena;\n"
"u suprotnom će biti umetnuta nova stranica korica"

#: dialogs.py:74
msgid "Insert or replace cover"
msgstr "Umetni ili zameni korice"

#: dialogs.py:78
msgid "Update metadata"
msgstr "Ažuriraj metapodatke"

#: dialogs.py:78
msgid ""
"Update the manifest with the latest calibre metadata\n"
"and replace an existing identifiable cover if possible."
msgstr ""
"Ažuriraj manifest najnovijim metapodacima iz calibre-a\n"
"i, ako je moguće, zameni prepoznate postojeće korice."

#: dialogs.py:79
msgid ""
"Remove any metadata from the .opf manifest that is not in the dc: namespace.\n"
"Such entries are created by editing in Sigil or calibre updating metadata.\n"
"Use this option if publishing your ePubs externally."
msgstr ""
"Ukloni iz .opf manifesta sve metapodatke koji nisu u prostoru imena dc:.\n"
"Takvi zapisi nastaju pri uređivanju u Sigilu ili pri ažuriranju metapodataka u calibre-u.\n"
"Koristite ovu opciju ako ePub knjige objavljujete izvan calibre-a."

#: dialogs.py:79
msgid "Remove non dc: metadata elements"
msgstr "Ukloni elemente metapodataka koji nisu u prostoru imena dc:"

#: dialogs.py:83
msgid "Encode HTML in UTF-8"
msgstr "Kodiraj HTML kao UTF-8"

#: dialogs.py:83
msgid ""
"Removes any existing <meta> charset tags on html pages and encodes in UTF-8.\n"
"For use where ebook does not display quotes in calibre viewer correctly."
msgstr ""
"Uklanja postojeće oznake <meta> za skup znakova sa HTML stranica i kodira ih kao UTF-8.\n"
"Koristite ako se navodnici ne prikazuju ispravno u calibre čitaču e-knjiga."

#: dialogs.py:84
msgid "Remove embedded fonts"
msgstr "Ukloni ugrađene fontove"

#: dialogs.py:84
msgid ""
"Remove embedded fonts from the manifest and their files to reduce ePub size.\n"
"Also removes @font-face declarations."
msgstr ""
"Uklanja ugrađene fontove iz manifesta i njihove datoteke radi smanjenja ePub knjige.\n"
"Uklanja i deklaracije @font-face."

#: dialogs.py:85
msgid "Modify @page and body margin styles"
msgstr "Izmeni margine u stilovima @page i body"

#: dialogs.py:85
msgid ""
"Replace margin styles for @page or body with your calibre defaults in a new @page style.\n"
"If your calibre defaults are negative, removes the margin attributes and if necessary the CSS file."
msgstr ""
"Zameni margine u stilovima @page ili body podrazumevanim vrednostima iz calibre-a u novom stilu @page.\n"
"Ako su podrazumevane vrednosti negativne, ukloni atribute margina i, po potrebi, CSS datoteku."

#: dialogs.py:86
msgid "Append extra CSS"
msgstr "Dodaj dodatni CSS"

#: dialogs.py:86
msgid ""
"Appends any Extra CSS you have defined in your calibre defaults to every .CSS file.\n"
"If you have no extra CSS defined or text already contained then it does nothing."
msgstr ""
"Dodaje dodatni CSS definisan u podrazumevanim podešavanjima calibre-a u svaku .CSS datoteku.\n"
"Ako dodatni CSS nije definisan ili je taj tekst već prisutan, ništa se ne menja."

#: dialogs.py:87
msgid "Convert html to use smart quotes and emdash characters"
msgstr "Pretvori HTML tako da koristi tipografske navodnike i duge crtice"

#: dialogs.py:87
msgid "Smarten punctuation"
msgstr "Ulepšaj interpunkciju"

#: dialogs.py:88
msgid "Remove any .js files and inline javascript blocks"
msgstr "Ukloni sve .js datoteke i ugrađene JavaScript blokove"

#: dialogs.py:88
msgid "Remove inline javascript and files"
msgstr "Ukloni ugrađeni JavaScript i datoteke"

#: dialogs.py:103
msgid "Modify ePub Options"
msgstr "Opcije za izmenu ePub knjige"

#: dialogs.py:128
msgid "Known Artifacts"
msgstr "Poznate pomoćne datoteke"

#: dialogs.py:129
msgid "Manifest"
msgstr "Manifest"

#: dialogs.py:130
msgid "Adobe"
msgstr "Adobe"

#: dialogs.py:131
msgid "Table of Contents"
msgstr "Sadržaj"

#: dialogs.py:133
msgid "HTML && Styles"
msgstr "HTML && stilovi"

#: dialogs.py:134
msgid "Metadata Jackets"
msgstr "Stranice sa metapodacima"

#: dialogs.py:135
msgid "Covers"
msgstr "Korice"

#: dialogs.py:136
msgid "Metadata"
msgstr "Metapodaci"

#: dialogs.py:142
msgid "Clear all"
msgstr "Poništi izbor svega"

#: dialogs.py:143
msgid "Clear all selections"
msgstr "Poništi sav izbor"

#: dialogs.py:145
msgid "Save"
msgstr "Sačuvaj"

#: dialogs.py:146
msgid ""
"Save the current selected settings for future recall with the Restore button"
msgstr ""
"Sačuvaj trenutno izabrana podešavanja da bi se kasnije vratila dugmetom "
"„Vrati“"

#: dialogs.py:148
msgid "Restore"
msgstr "Vrati"

#: dialogs.py:149
msgid "Restore your settings set when the Save button was last clicked"
msgstr "Vrati podešavanja sačuvana poslednjim klikom na dugme „Sačuvaj“"

#: dialogs.py:179
msgid "No options selected"
msgstr "Nijedna opcija nije izabrana"

#: dialogs.py:180
msgid "You must select at least one option to continue"
msgstr "Morate izabrati bar jednu opciju da biste nastavili"

#: dialogs.py:206 dialogs.py:275
msgid "Cancel"
msgstr "Otkaži"

#: dialogs.py:206 dialogs.py:275
msgid "Working"
msgstr "Radim"

#: dialogs.py:207
msgid "Queueing books for modifying ePubs"
msgstr "Dodavanje knjiga u red za izmenu ePub datoteka"

#: dialogs.py:223
msgid "Queueing"
msgstr "Dodavanje u red"

#: dialogs.py:255
msgid "Could not modify ePub for some books"
msgstr "Za neke knjige nije bilo moguće izmeniti ePub"

#: dialogs.py:256
msgid ""
"Could not modify %d of %d books, because no ePub source format was found."
msgstr ""
"Nije bilo moguće izmeniti %d od %d knjiga jer njihov izvorni format ePub "
"nije pronađen."

#: dialogs.py:276
msgid "Adding %d modified ePubs"
msgstr "Dodavanje %d izmenjenih ePub datoteka"

#: dialogs.py:297
msgid "Adding"
msgstr "Dodavanje"

#: dialogs.py:312
msgid "ePub files updated"
msgstr "ePub datoteke su ažurirane"
