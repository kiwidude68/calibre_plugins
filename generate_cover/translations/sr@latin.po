#, python-format
msgid ""
"Corrupted setting: \"%(setting_name)s\" has incorrect internal name of: "
"\"%(internal_name)s\")"
msgstr ""
"Oštećeno podešavanje: \"%(setting_name)s\" ima neispravno interno ime: "
"\"%(internal_name)s\")"

#: action.py:90
msgid "Corrupted Configuration File"
msgstr "Oštećena konfiguraciona datoteka"

#: action.py:91
msgid ""
"<p>Your configuration file was corrupted (see Details).</p>)<p>Please report"
" your exact recent actions which led to this on the MobileRead forum thread "
"for this plugin so it can be fixed.</p><p>The configuration has been fixed "
"automatically.</p>"
msgstr ""
"<p>Vaša konfiguraciona datoteka je oštećena (pogledajte "
"Detalje).</p>)<p>Molimo prijavite vaše tačne nedavne akcije koje su dovele "
"do ovoga na MobileRead forumu za ovaj dodatak kako bi se to moglo "
"popraviti.</p><p>Konfiguracija je automatski popravljena.</p>"

#: action.py:137 action.py:147
msgid "Cannot generate cover"
msgstr "Nije moguće generisati korice"

#: action.py:138
