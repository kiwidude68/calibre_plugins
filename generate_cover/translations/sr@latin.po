#: dialogs.py:916
msgid "Cannot read"
msgstr "Nije moguće čitati"

#: dialogs.py:917
msgid "You do not have permission to read the file."
msgstr "Nemate dozvolu da čitate datoteku."

#: dialogs.py:928
msgid "Cannot copy"
msgstr "Nije moguće kopirati"

#: dialogs.py:942
msgid "Overwrite existing"
msgstr "Prepiši postojeće"

#: dialogs.py:943
msgid ""
"An image file already exists with this name. Do you want to overwrite it?"
msgstr ""
"Datoteka slike sa ovim imenom već postoji. Da li želite da je prepišete?"

#: dialogs.py:946
msgid "Enter image name"
msgstr "Unesite ime slike"

#: dialogs.py:947
msgid "Enter a unique name for this image:"
msgstr "Unesite jedinstveno ime za ovu sliku:"

#: dialogs.py:961
msgid "You do not have permission to overwrite the file"
msgstr "Nemate dozvolu da prepišete datoteku"

#: dialogs.py:997 dialogs.py:1005
msgid "Title"
msgstr "Naslov"

#: dialogs.py:998 dialogs.py:1006
msgid "Author"
msgstr "Autor"

#: dialogs.py:999 dialogs.py:1007
msgid "Series"
msgstr "Serija"

#: dialogs.py:1000 dialogs.py:1008
msgid "Custom"
msgstr "Prilagođeno"

#: dialogs.py:1001 dialogs.py:1009
msgid "Custom 2"
msgstr "Prilagođeno 2"

#: dialogs.py:1002 dialogs.py:1010
msgid "Custom 3"
msgstr "Prilagođeno 3"

#: dialogs.py:1019 dialogs.py:1262 dialogs.py:1417
msgid "Color:"
msgstr "Boja:"

#: dialogs.py:1024
msgid "Fill Color:"
msgstr "Boja ispune:"

#: dialogs.py:1026
msgid "Choose selected field fill color"
msgstr "Izaberi boju ispune izabranog polja"

#: dialogs.py:1030
msgid "Reset selected field fill color"
msgstr "Vrati boju ispune izabranog polja na podrazumevanu"

#: dialogs.py:1033
msgid "Use this fill color for all text"
msgstr "Koristi ovu boju ispune za sav tekst"

#: dialogs.py:1034
msgid ""
"When checked, the current fill color is used for all text.\n"
"When unchecked, you can set a different fill color for each field."
msgstr ""
"Ako je označeno, trenutna boja ispune koristi se za sav tekst.\n"
"Ako nije označeno, možete postaviti različitu boju ispune za svako polje."

#: dialogs.py:1044
msgid "Backdrop:"
msgstr "Podloga:"

#: dialogs.py:1045
msgid "Optionally render a color backdrop for this element"
msgstr "Opciono prikaži obojenu podlogu za ovaj element"

#: dialogs.py:1049
msgid "Choose this element's backdrop color, if applied"
msgstr "Izaberi boju podloge ovog elementa, ako se koristi"

#: dialogs.py:1053
msgid "Reset selected field backdrop color"
msgstr "Vrati boju podloge izabranog polja na podrazumevanu"

#: dialogs.py:1055
msgid "Use this backdrop for all text"
msgstr "Koristi ovu podlogu za sav tekst"

#: dialogs.py:1063
msgid "Opacity:"
msgstr "Neprozirnost:"

#: dialogs.py:1068
msgid "Full width or height"
msgstr "Puna širina ili visina"

#: dialogs.py:1069
msgid ""
"When checked, the backdrop will extend to the full width of the cover (height if rotated).\n"
"When unchecked, the backdrop will only extend to the width or height of the text."
msgstr ""
"Ako je označeno, podloga se proteže celom širinom korica (visinom ako je rotirana).\n"
"Ako nije označeno, podloga se proteže samo širinom ili visinom teksta."

#: dialogs.py:1155
msgid "Size:"
msgstr "Veličina:"

#: dialogs.py:1161
msgid "Cover width:"
msgstr "Širina korica:"

#: dialogs.py:1162
msgid "The width in pixels of the output .jpg file"
msgstr "Širina u pikselima izlazne .jpg datoteke"

#: dialogs.py:1168
msgid "Height:"
msgstr "Visina:"

#: dialogs.py:1169
msgid "The height in pixels of the output .jpg file"
msgstr "Visina u pikselima izlazne .jpg datoteke"

#: dialogs.py:1178
msgid "Background:"
msgstr "Pozadina:"

#: dialogs.py:1181
msgid "Choose the background color"
msgstr "Izaberi boju pozadine"

#: dialogs.py:1186
msgid "Reset background color"
msgstr "Vrati boju pozadine na podrazumevanu"

#: dialogs.py:1189
msgid "Resize cover dimensions to match background image"
msgstr "Promeni dimenzije korica da odgovaraju pozadinskoj slici"

#: dialogs.py:1190
msgid ""
"Check this to automatically resize the cover based on\n"
"the dimensions of the currently chosen background image"
msgstr ""
"Označite ovo da biste automatski promenili veličinu korica na osnovu\n"
"dimenzija trenutno izabrane pozadinske slike"

#: dialogs.py:1194
msgid "Resize image to scale up if smaller than available area"
msgstr "Povećaj sliku ako je manja od dostupnog prostora"

#: dialogs.py:1195
msgid ""
"Check this to automatically resize the cover image to fit the\n"
"the maximum area available if it is too small"
msgstr ""
"Označite ovo da biste automatski promenili veličinu slike korica da stane u\n"
"maksimalni dostupni prostor ako je previše mala"

#: dialogs.py:1201
msgid "Margins:"
msgstr "Margine:"

#: dialogs.py:1208
msgid "Top:"
msgstr "Gore:"

#: dialogs.py:1209
msgid ""
"The margin in pixels from the top of the cover\n"
"to the first content"
msgstr ""
"Margina u pikselima od vrha korica\n"
"do prvog sadržaja"

#: dialogs.py:1217 dialogs.py:1332
msgid "Bottom:"
msgstr "Dole:"

#: dialogs.py:1218
msgid ""
"The margin in pixels from the bottom of the cover\n"
"to the last content"
msgstr ""
"Margina u pikselima od dna korica\n"
"do poslednjeg sadržaja"

#: dialogs.py:1228
msgid "Left:"
msgstr "Levo:"

#: dialogs.py:1229
msgid ""
"The minimum margin in pixels from the left of the cover\n"
"to the text content"
msgstr ""
"Minimalna margina u pikselima od leve strane korica\n"
"do tekstualnog sadržaja"

#: dialogs.py:1237 dialogs.py:1333
msgid "Right:"
msgstr "Desno:"

#: dialogs.py:1238
msgid ""
"The minimum margin in pixels from the right of the cover\n"
"to the text content"
msgstr ""
"Minimalna margina u pikselima od desne strane korica\n"
"do tekstualnog sadržaja"

#: dialogs.py:1247 dialogs.py:1401
msgid "Border:"
msgstr "Okvir:"

#: dialogs.py:1253
msgid "Border width:"
msgstr "Širina okvira:"

#: dialogs.py:1254
msgid ""
"The width in pixels of a border around the edge\n"
"of the cover. Specify 0 for no border"
msgstr ""
"Širina u pikselima ivice oko ruba\n"
"korica. Unesite 0 za bez ivice"

#: dialogs.py:1265
msgid "Choose the border color"
msgstr "Izaberi boju okvira"

#: dialogs.py:1270
msgid "Reset border color"
msgstr "Vrati boju okvira na podrazumevanu"

#: dialogs.py:1332
msgid "Padding Top:"
msgstr "Unutrašnji razmak gore:"

#: dialogs.py:1333
msgid "Padding Left:"
msgstr "Unutrašnji razmak levo:"

#: dialogs.py:1362
msgid "Field Order:"
msgstr "Redosled polja:"

#: dialogs.py:1363
msgid ""
"Alter the order of items on the cover and\n"
"whether they are displayed using the checkbox"
msgstr ""
"Promenite redosled stavki na koricama i\n"
"da li se prikazuju pomoću polja za potvrdu"

#: dialogs.py:1377
msgid "Move field up"
msgstr "Pomeri polje gore"

#: dialogs.py:1383
msgid "Move field down"
msgstr "Pomeri polje dole"

#: dialogs.py:1389
msgid "Image:"
msgstr "Slika:"

#: dialogs.py:1393
msgid "Stretch image to use as cover background"
msgstr "Razvuci sliku da se koristi kao pozadina korica"

#: dialogs.py:1394
msgid ""
"Check this to overlay text on the image background.\n"
"Uncheck this to place text around the image."
msgstr ""
"Označite ovo da biste preklopili tekst preko pozadine slike.\n"
"Odznačite ovo da biste postavili tekst oko slike."

#: dialogs.py:1407
msgid "Image border:"
msgstr "Ivica slike:"

#: dialogs.py:1409
msgid "The width in pixels of a border around the edge of the image"
msgstr "Širina okvira oko ivice slike u pikselima"

#: dialogs.py:1421
msgid ""
"Choose the image border color (if it is not stretched to the cover edge)"
msgstr "Izaberi boju okvira slike (ako slika nije razvučena do ivice korica)"

#: dialogs.py:1427
msgid "Reset image border color"
msgstr "Vrati boju okvira slike na podrazumevanu"

#: dialogs.py:1440 dialogs.py:1447
msgid "Font:"
msgstr "Font:"

#: dialogs.py:1451
msgid "Choose the font family for the selected field"
msgstr "Izaberi porodicu fontova za izabrano polje"

#: dialogs.py:1459
msgid "Font size in pixels"
msgstr "Veličina fonta u pikselima"

#: dialogs.py:1466
msgid "Use this font family for all text"
msgstr "Koristi ovu porodicu fontova za sav tekst"

#: dialogs.py:1467
msgid ""
"When checked, this font family is used for all text content on the cover"
msgstr ""
"Ako je označeno, ova porodica fontova koristi se za sav tekstualni sadržaj "
"na koricama"

#: dialogs.py:1470
msgid "Auto-reduce font size to fit on one line"
msgstr "Automatski smanji veličinu fonta da stane u jedan red"

#: dialogs.py:1471
msgid ""
"When checked, this font size will be used as a maximum size.\n"
"A reduced size will be used where needed to fit text on one line."
msgstr ""
"Ako je označeno, ova veličina fonta koristi se kao najveća dozvoljena veličina.\n"
"Po potrebi se koristi manja veličina kako bi tekst stao u jedan red."

#: dialogs.py:1477
msgid "Style:"
msgstr "Stil:"

#: dialogs.py:1482 dialogs.py:1520
msgid "Left"
msgstr "Levo"

#: dialogs.py:1483
msgid "Centre"
msgstr "Centrirano"

