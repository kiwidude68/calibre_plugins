msgstr "Podešavanje korica izvezeno u<br>%s"

#: dialogs.py:804
msgid "Select setting file(s) to import"
msgstr "Izaberite datoteku(e) podešavanja za uvoz"

#: dialogs.py:805 dialogs.py:811
msgid "GC Files"
msgstr "GC datoteke"

#: dialogs.py:811
msgid "Save setting as"
msgstr "Sačuvaj podešavanje kao"

#: dialogs.py:838
msgid "You cannot rename this image"
msgstr "Ne možete preimenovati ovu sliku"

#: dialogs.py:840 dialogs.py:841
msgid "New image name:"
msgstr "Novo ime slike:"

#: dialogs.py:858
msgid "File exists"
msgstr "Datoteka postoji"

#: dialogs.py:859
msgid "An image already exists with this name."
msgstr "Slika sa ovim imenom već postoji."

#: dialogs.py:864
msgid "Failed to rename image"
msgstr "Preimenovanje slike nije uspelo"

#: dialogs.py:873
msgid "Add cover images"
msgstr "Dodaj slike korica"

#: dialogs.py:888
msgid "You cannot remove this image"
msgstr "Ne možete ukloniti ovu sliku"

#: dialogs.py:891
#, python-format
msgid "Are you sure you want to delete the image: %s"
msgstr "Da li ste sigurni da želite da obrišete sliku: %s"

#: dialogs.py:902 dialogs.py:960
msgid "Cannot write"
msgstr "Nije moguće pisati"

#: dialogs.py:903
msgid "You do not have permission to delete the file"
