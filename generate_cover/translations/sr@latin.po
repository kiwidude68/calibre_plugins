msgstr "Dodaj novo podešavanje"

#: dialogs.py:634
msgid "Cannot add"
msgstr "Nije moguće dodati"

#: dialogs.py:635
msgid "The name you specified is not unique"
msgstr "Ime koje ste naveli nije jedinstveno"

#: dialogs.py:644 dialogs.py:887
msgid "Cannot remove"
msgstr "Nije moguće ukloniti"

#: dialogs.py:645
msgid "You cannot remove the default setting"
msgstr "Ne možete ukloniti podrazumevano podešavanje"

#: dialogs.py:646 dialogs.py:890 dialogs.py:1754 dialogs.py:1773
msgid "Are you sure?"
msgstr "Da li ste sigurni?"

#: dialogs.py:647
#, python-format
