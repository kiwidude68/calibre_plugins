msgstr "Nije moguće preimenovati"

#: dialogs.py:661
msgid "You cannot rename the default setting"
msgstr "Ne možete preimenovati podrazumevano podešavanje"

#: dialogs.py:662 dialogs.py:663
msgid "New setting name:"
msgstr "Novo ime podešavanja:"

#: dialogs.py:671
msgid "Setting exists"
msgstr "Podešavanje postoji"

#: dialogs.py:672
msgid "A saved setting already exists with this name."
msgstr "Sačuvano podešavanje sa ovim imenom već postoji."

#: dialogs.py:697
msgid "Import Failed"
msgstr "Uvoz nije uspeo"

#: dialogs.py:698
msgid "This is not a valid Generate Cover export archive"
