#: dialogs.py:158
msgid "Generate && Save"
msgstr "Generiši && sačuvaj"

#: dialogs.py:159
msgid "Generate cover using these settings and save for future usage"
msgstr ""
"Generiši korice koristeći ova podešavanja i sačuvaj za buduću upotrebu"

#: dialogs.py:161
msgid "Generate && Revert"
msgstr "Generiši && vrati"

#: dialogs.py:162
msgid "Generate cover using these settings then discard them"
msgstr "Generiši korice koristeći ova podešavanja, a zatim ih odbaci"

#: dialogs.py:166
