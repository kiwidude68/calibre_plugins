msgstr "Importera inställning"

#: dialogs.py:515
msgid "Export setting"
msgstr "Exportera inställning"

#: dialogs.py:521
msgid "Delete setting from this list"
msgstr "Ta bort inställningen från listan"

#: dialogs.py:529
msgid "Select Image:"
msgstr "Välj bild:"

#: dialogs.py:540
msgid "Add image to this list"
msgstr "Lägg till en bild i listan"

#: dialogs.py:545
msgid "Rename image"
msgstr "Byt namn på bild"

#: dialogs.py:550
msgid "Remove image from this list"
msgstr "Ta bort bilden från listan"

#: dialogs.py:561
msgid "Saved Settings: (*unsaved changes)"
msgstr "Sparade inställningar: (*osparade ändringar)"

#: dialogs.py:592
msgid "Add new setting"
msgstr "Lägg till ny inställning"

#: dialogs.py:615
msgid "Cannot add"
msgstr "Kan inte lägga till"

#: dialogs.py:616
msgid "The name you specified is not unique"
msgstr "Namnet du angav är inte unikt"

#: dialogs.py:625 dialogs.py:868
msgid "Cannot remove"
msgstr "Kan inte ta bort"

#: dialogs.py:626
msgid "You cannot remove the default setting"
msgstr "Du kan inte ta bort standardinställningen"

#: dialogs.py:627 dialogs.py:871 dialogs.py:1722 dialogs.py:1741
msgid "Are you sure?"
msgstr "Är du säker?"

#: dialogs.py:628
#, python-format
msgid "Are you sure you want to remove the '%s' setting?"
msgstr "Vill du verkligen ta bort inställningen ”%s”?"

#: dialogs.py:641 dialogs.py:818 dialogs.py:844
msgid "Cannot rename"
msgstr "Kan inte byta namn"

#: dialogs.py:642
msgid "You cannot rename the default setting"
msgstr "Du kan inte byta namn på standardinställningen"

#: dialogs.py:643 dialogs.py:644
msgid "New setting name:"
msgstr "Nytt inställningsnamn:"

#: dialogs.py:652
msgid "Setting exists"
msgstr "Inställningen finns redan"

#: dialogs.py:653
msgid "A saved setting already exists with this name."
msgstr "Det finns redan en sparad inställning med detta namn."

#: dialogs.py:678
msgid "Import Failed"
msgstr "Importen misslyckades"

#: dialogs.py:679
msgid "This is not a valid Generate Cover export archive"
msgstr "Detta är inte ett giltigt exportarkiv från Skapa omslag"

#: dialogs.py:717
msgid "Cannot import"
msgstr "Kan inte importera"

#: dialogs.py:718 dialogs.py:910
msgid "Failed to copy image"
msgstr "Det gick inte att kopiera bilden"

#: dialogs.py:776
msgid "Export completed"
msgstr "Exporten slutförd"

#: dialogs.py:777
#, python-format
msgid "Cover setting exported to<br>%s"
msgstr "Omslagsinställningen exporterades till<br>%s"

#: dialogs.py:785
msgid "Select setting file(s) to import"
msgstr "Välj inställningsfiler att importera"

#: dialogs.py:786 dialogs.py:792
msgid "GC Files"
msgstr "GC-filer"

#: dialogs.py:792
msgid "Save setting as"
msgstr "Spara inställning som"

#: dialogs.py:819
msgid "You cannot rename this image"
msgstr "Du kan inte byta namn på denna bild"

#: dialogs.py:821 dialogs.py:822
msgid "New image name:"
msgstr "Nytt bildnamn:"

#: dialogs.py:839
msgid "File exists"
msgstr "Filen finns redan"

#: dialogs.py:840
msgid "An image already exists with this name."
msgstr "Det finns redan en bild med detta namn."

#: dialogs.py:845
msgid "Failed to rename image"
msgstr "Det gick inte att byta namn på bilden"

#: dialogs.py:854
msgid "Add cover images"
msgstr "Lägg till omslagsbilder"

#: dialogs.py:869
msgid "You cannot remove this image"
msgstr "Du kan inte ta bort denna bild"

#: dialogs.py:872
#, python-format
msgid "Are you sure you want to delete the image: %s"
msgstr "Vill du verkligen ta bort bilden: %s"

#: dialogs.py:883 dialogs.py:941
msgid "Cannot write"
msgstr "Kan inte skriva"

#: dialogs.py:884
msgid "You do not have permission to delete the file"
msgstr "Du har inte behörighet att ta bort filen"

#: dialogs.py:897
msgid "Cannot read"
msgstr "Kan inte läsa"

#: dialogs.py:898
msgid "You do not have permission to read the file."
msgstr "Du har inte behörighet att läsa filen."

#: dialogs.py:909
msgid "Cannot copy"
msgstr "Kan inte kopiera"

#: dialogs.py:923
msgid "Overwrite existing"
msgstr "Skriv över befintlig"

#: dialogs.py:924
msgid ""
"An image file already exists with this name. Do you want to overwrite it?"
msgstr "Det finns redan en bildfil med detta namn. Vill du skriva över den?"

#: dialogs.py:927
msgid "Enter image name"
msgstr "Ange bildnamn"

#: dialogs.py:928
msgid "Enter a unique name for this image:"
msgstr "Ange ett unikt namn för bilden:"

#: dialogs.py:942
msgid "You do not have permission to overwrite the file"
msgstr "Du har inte behörighet att skriva över filen"

#: dialogs.py:978 dialogs.py:986
msgid "Title"
msgstr "Titel"

#: dialogs.py:979 dialogs.py:987
msgid "Author"
msgstr "Författare"

#: dialogs.py:980 dialogs.py:988
msgid "Series"
msgstr "Serie"

#: dialogs.py:981 dialogs.py:989
msgid "Custom"
msgstr "Anpassad"

#: dialogs.py:982 dialogs.py:990
msgid "Custom 2"
msgstr "Anpassad 2"

#: dialogs.py:983 dialogs.py:991
msgid "Custom 3"
msgstr "Anpassad 3"

#: dialogs.py:1000 dialogs.py:1243 dialogs.py:1398
msgid "Color:"
msgstr "Färg:"

#: dialogs.py:1005
msgid "Fill Color:"
msgstr "Fyllningsfärg:"

#: dialogs.py:1007
msgid "Choose selected field fill color"
msgstr "Välj fyllningsfärg för det valda fältet"

#: dialogs.py:1011
msgid "Reset selected field fill color"
msgstr "Återställ fyllningsfärgen för det valda fältet"

#: dialogs.py:1014
msgid "Use this fill color for all text"
msgstr "Använd denna fyllningsfärg för all text"

#: dialogs.py:1015
msgid ""
"When checked, the current fill color is used for all text.\n"
"When unchecked, you can set a different fill color for each field."
msgstr ""
"När alternativet är markerat används den aktuella fyllningsfärgen för all text.\n"
"Annars kan du välja en egen fyllningsfärg för varje fält."

#: dialogs.py:1025
msgid "Backdrop:"
msgstr "Textbakgrund:"

#: dialogs.py:1026
msgid "Optionally render a color backdrop for this element"
msgstr "Visa en färgad bakgrund bakom detta element"

#: dialogs.py:1030
msgid "Choose this element's backdrop color, if applied"
msgstr "Välj färg för elementets bakgrund, om den är aktiverad"

#: dialogs.py:1034
msgid "Reset selected field backdrop color"
msgstr "Återställ bakgrundsfärgen för det valda fältet"

#: dialogs.py:1036
msgid "Use this backdrop for all text"
msgstr "Använd denna bakgrund för all text"

#: dialogs.py:1044
msgid "Opacity:"
msgstr "Opacitet:"

#: dialogs.py:1049
msgid "Full width or height"
msgstr "Full bredd eller höjd"

#: dialogs.py:1050
msgid ""
"When checked, the backdrop will extend to the full width of the cover (height if rotated).\n"
"When unchecked, the backdrop will only extend to the width or height of the text."
msgstr ""
"När alternativet är markerat sträcker sig textbakgrunden över hela omslagets bredd (höjd om texten är roterad).\n"
"Annars sträcker sig textbakgrunden bara över textens bredd eller höjd."

#: dialogs.py:1136
msgid "Size:"
msgstr "Storlek:"

#: dialogs.py:1142
msgid "Cover width:"
msgstr "Omslagsbredd:"

#: dialogs.py:1143
msgid "The width in pixels of the output .jpg file"
msgstr "Bredden i bildpunkter på den skapade .jpg-filen"

#: dialogs.py:1149
msgid "Height:"
msgstr "Höjd:"

#: dialogs.py:1150
msgid "The height in pixels of the output .jpg file"
msgstr "Höjden i bildpunkter på den skapade .jpg-filen"

#: dialogs.py:1159
msgid "Background:"
msgstr "Bakgrund:"

#: dialogs.py:1162
msgid "Choose the background color"
msgstr "Välj bakgrundsfärg"

#: dialogs.py:1167
msgid "Reset background color"
msgstr "Återställ bakgrundsfärgen"

#: dialogs.py:1170
msgid "Resize cover dimensions to match background image"
msgstr "Ändra omslagets mått så att de motsvarar bakgrundsbilden"

#: dialogs.py:1171
msgid ""
"Check this to automatically resize the cover based on\n"
"the dimensions of the currently chosen background image"
msgstr ""
"Markera detta för att automatiskt ändra omslagets storlek utifrån\n"
"måtten på den valda bakgrundsbilden"

#: dialogs.py:1175
msgid "Resize image to scale up if smaller than available area"
msgstr "Förstora bilden om den är mindre än det tillgängliga området"

#: dialogs.py:1176
msgid ""
"Check this to automatically resize the cover image to fit the\n"
"the maximum area available if it is too small"
msgstr ""
"Markera detta för att automatiskt förstora omslagsbilden så att den fyller\n"
"det största tillgängliga området om den är för liten"

#: dialogs.py:1182
msgid "Margins:"
msgstr "Marginaler:"

#: dialogs.py:1189
msgid "Top:"
msgstr "Upptill:"

#: dialogs.py:1190
msgid ""
"The margin in pixels from the top of the cover\n"
"to the first content"
msgstr ""
"Marginalen i bildpunkter från omslagets överkant\n"
"till det första innehållet"

#: dialogs.py:1198 dialogs.py:1313
msgid "Bottom:"
msgstr "Nedtill:"

#: dialogs.py:1199
msgid ""
"The margin in pixels from the bottom of the cover\n"
"to the last content"
msgstr ""
"Marginalen i bildpunkter från omslagets nederkant\n"
"till det sista innehållet"

#: dialogs.py:1209
msgid "Left:"
msgstr "Vänster:"

#: dialogs.py:1210
msgid ""
"The minimum margin in pixels from the left of the cover\n"
"to the text content"
msgstr ""
"Minsta marginalen i bildpunkter från omslagets vänsterkant\n"
"till textinnehållet"

#: dialogs.py:1218 dialogs.py:1314
msgid "Right:"
msgstr "Höger:"

#: dialogs.py:1219
msgid ""
"The minimum margin in pixels from the right of the cover\n"
"to the text content"
msgstr ""
"Minsta marginalen i bildpunkter från omslagets högerkant\n"
"till textinnehållet"

#: dialogs.py:1228 dialogs.py:1382
msgid "Border:"
msgstr "Kantlinje:"

#: dialogs.py:1234
msgid "Border width:"
msgstr "Kantlinjens bredd:"

#: dialogs.py:1235
msgid ""
"The width in pixels of a border around the edge\n"
"of the cover. Specify 0 for no border"
msgstr ""
"Bredden i bildpunkter på kantlinjen runt\n"
"omslaget. Ange 0 för ingen kantlinje"

#: dialogs.py:1246
msgid "Choose the border color"
msgstr "Välj kantlinjens färg"

#: dialogs.py:1251
msgid "Reset border color"
msgstr "Återställ kantlinjens färg"

#: dialogs.py:1313
msgid "Padding Top:"
msgstr "Inre marginal upptill:"

#: dialogs.py:1314
msgid "Padding Left:"
msgstr "Inre marginal till vänster:"

#: dialogs.py:1343
msgid "Field Order:"
msgstr "Fältordning:"

#: dialogs.py:1344
msgid ""
"Alter the order of items on the cover and\n"
"whether they are displayed using the checkbox"
msgstr ""
"Ändra ordningen på objekten på omslaget och\n"
"markera med kryssrutorna vilka som ska visas"

#: dialogs.py:1358
msgid "Move field up"
msgstr "Flytta fält upp"

#: dialogs.py:1364
msgid "Move field down"
msgstr "Flytta fält ned"

#: dialogs.py:1370
msgid "Image:"
msgstr "Bild:"

#: dialogs.py:1374
msgid "Stretch image to use as cover background"
msgstr "Sträck ut bilden och använd den som omslagsbakgrund"

#: dialogs.py:1375
msgid ""
"Check this to overlay text on the image background.\n"
"Uncheck this to place text around the image."
msgstr ""
"Markera detta för att lägga text ovanpå bildbakgrunden.\n"
"Avmarkera det för att placera text runt bilden."

#: dialogs.py:1388
msgid "Image border:"
msgstr "Bildens kantlinje:"

#: dialogs.py:1390
msgid "The width in pixels of a border around the edge of the image"
msgstr "Bredden i bildpunkter på kantlinjen runt bilden"

#: dialogs.py:1402
msgid ""
"Choose the image border color (if it is not stretched to the cover edge)"
msgstr ""
"Välj färg på bildens kantlinje (om bilden inte är utsträckt till omslagets "
"kant)"

#: dialogs.py:1408
msgid "Reset image border color"
msgstr "Återställ färgen på bildens kantlinje"

#: dialogs.py:1421 dialogs.py:1428
msgid "Font:"
msgstr "Teckensnitt:"

#: dialogs.py:1432
msgid "Choose the font family for the selected field"
msgstr "Välj teckensnittsfamilj för det valda fältet"

#: dialogs.py:1440
msgid "Font size in pixels"
msgstr "Teckenstorlek i bildpunkter"

#: dialogs.py:1447
msgid "Use this font family for all text"
msgstr "Använd denna teckensnittsfamilj för all text"

#: dialogs.py:1448
msgid ""
"When checked, this font family is used for all text content on the cover"
msgstr ""
"När alternativet är markerat används denna teckensnittsfamilj för all text "
"på omslaget"

#: dialogs.py:1451
msgid "Auto-reduce font size to fit on one line"
msgstr "Minska teckenstorleken automatiskt så att texten ryms på en rad"

#: dialogs.py:1452
msgid ""
"When checked, this font size will be used as a maximum size.\n"
"A reduced size will be used where needed to fit text on one line."
msgstr ""
"När alternativet är markerat används denna teckenstorlek som maximal storlek.\n"
"Vid behov minskas storleken så att texten ryms på en rad."

#: dialogs.py:1458
msgid "Alignment:"
msgstr "Justering:"

#: dialogs.py:1463 dialogs.py:1500
msgid "Left"
msgstr "Vänster"

#: dialogs.py:1464
msgid "Centre"
msgstr "Centrerad"

#: dialogs.py:1465 dialogs.py:1501
msgid "Right"
msgstr "Höger"

#: dialogs.py:1468
msgid "Bold"
msgstr "Fet"

#: dialogs.py:1472
msgid "Italic"
msgstr "Kursiv"

#: dialogs.py:1475
msgid "Underline"
msgstr "Understruken"

#: dialogs.py:1482
msgid "Rotation:"
msgstr "Rotation:"

#. TRANSLATORS: Text rotation angle in degrees (0, 90, or 270), not
#. temperature.
#. Keep %d; use a suitable local degree symbol or abbreviation.
#: dialogs.py:1490
#, python-format
msgid "%d°"
msgstr "%d°"

#: dialogs.py:1491
msgid "Rotate the selected text field"
msgstr "Rotera det valda textfältet"

#: dialogs.py:1495
msgid "Placement:"
msgstr "Placering:"

#: dialogs.py:1502
msgid "Place vertical text along the left or right edge"
msgstr "Placera lodrät text längs vänster eller höger kant"

#: dialogs.py:1516
msgid "Data:"
msgstr "Data:"

#: dialogs.py:1521
msgid "Text:"
msgstr "Text:"

