#: ..\common\common_widgets.py:234
msgid "Create new column"
msgstr "Skapa ny kolumn"

#: action.py:30
msgid "Generate Cover"
msgstr "Skapa omslag"

#: action.py:30
msgid "Generate a customised cover"
msgstr "Skapa ett anpassat omslag"

#: action.py:60
msgid "Cannot generate covers"
msgstr "Det går inte att skapa omslag"

#: action.py:61
msgid "No books selected"
msgstr "Inga böcker valda"

#: action.py:86
#, python-format
msgid ""
"Corrupted setting: \"%(setting_name)s\" has incorrect internal name of: "
"\"%(internal_name)s\")"
msgstr ""
"Skadad inställning: ”%(setting_name)s” har det felaktiga interna namnet "
"”%(internal_name)s”"

#: action.py:90
msgid "Corrupted Configuration File"
msgstr "Skadad konfigurationsfil"

#: action.py:91
msgid ""
"<p>Your configuration file was corrupted (see Details).</p>)<p>Please report"
" your exact recent actions which led to this on the MobileRead forum thread "
"for this plugin so it can be fixed.</p><p>The configuration has been fixed "
"automatically.</p>"
msgstr ""
"<p>Din konfigurationsfil var skadad (se Detaljer).</p><p>Beskriv exakt vilka"
" åtgärder du nyligen utförde som ledde till detta i MobileRead-forumtråden "
"för insticksmodulen, så att felet kan rättas.</p><p>Konfigurationen har "
"reparerats automatiskt.</p>"

#: action.py:137 action.py:147
msgid "Cannot generate cover"
msgstr "Det går inte att skapa omslaget"

#: action.py:138
msgid "Missing metadata passed for book to generate cover"
msgstr "Metadata saknas för boken som omslag ska skapas för"

