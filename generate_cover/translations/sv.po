#: dialogs.py:127 dialogs.py:150
msgid "Unsaved Changes"
msgstr "Osparade ändringar"

#: dialogs.py:131 dialogs.py:154
#, python-format
msgid "You have unsaved changes to the <b>%s</b> setting.<br>"
msgstr "Du har osparade ändringar i inställningen <b>%s</b>.<br>"

#: dialogs.py:132 dialogs.py:155
msgid "What do you want to do?"
msgstr "Vad vill du göra?"

#: dialogs.py:135
msgid "Discard Changes"
msgstr "Förkasta ändringar"

#: dialogs.py:136
msgid "Revert unsaved changes"
msgstr "Ångra osparade ändringar"

#: dialogs.py:138
msgid "Save Changes"
msgstr "Spara ändringar"

#: dialogs.py:139
msgid "Overwrite current profile with these changes"
msgstr "Skriv över den aktuella profilen med dessa ändringar"

#: dialogs.py:158
msgid "Generate && Save"
msgstr "Skapa && spara"

#: dialogs.py:159
msgid "Generate cover using these settings and save for future usage"
msgstr ""
"Skapa omslaget med dessa inställningar och spara dem för framtida användning"

#: dialogs.py:161
msgid "Generate && Revert"
msgstr "Skapa && återställ"

#: dialogs.py:162
msgid "Generate cover using these settings then discard them"
msgstr "Skapa omslaget med dessa inställningar och förkasta sedan ändringarna"

#: dialogs.py:166
msgid "Cancel action"
msgstr "Avbryt åtgärd"

#: dialogs.py:481 dialogs.py:559
msgid "Saved Settings:"
msgstr "Sparade inställningar:"

#: dialogs.py:491
msgid "Autosave settings"
msgstr "Spara inställningar automatiskt"

#: dialogs.py:492
msgid ""
"Do not prompt to save changes to a setting. Always save when\n"
"switching to another setting, clicking OK or using Import/Export."
msgstr ""
"Fråga inte om ändringar av en inställning ska sparas. Spara alltid när\n"
"du byter till en annan inställning, klickar på OK eller använder Importera/Exportera."

#: dialogs.py:499
msgid "Add setting"
msgstr "Lägg till inställning"

#: dialogs.py:504
msgid "Rename setting"
msgstr "Byt namn på inställning"

#: dialogs.py:510 dialogs.py:698
