msgid "You cannot remove the default setting"
msgstr "Du kan inte ta bort standardinställningen"

#: dialogs.py:646 dialogs.py:890 dialogs.py:1754 dialogs.py:1773
msgid "Are you sure?"
msgstr "Är du säker?"

#: dialogs.py:647
#, python-format
