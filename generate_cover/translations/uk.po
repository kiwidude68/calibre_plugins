#: dialogs.py:1168
msgid "Height:"
msgstr "Висота:"

#: dialogs.py:1169
msgid "The height in pixels of the output .jpg file"
msgstr "Висота у пікселях файла-результату .jpg"

#: dialogs.py:1178
msgid "Background:"
msgstr "Тло:"

