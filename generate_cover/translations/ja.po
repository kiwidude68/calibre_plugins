msgid ""
"The spacing in pixels between the image and text\n"
"placed above and below it"
msgstr ""
"画像と、その上下に配置されるテキストとの\n"
"間隔 (ピクセル単位)"

#: dialogs.py:1302
msgid "Border Widths:"
msgstr "境界線の幅:"

