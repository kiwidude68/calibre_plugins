msgid "Stretch image to use as cover background"
msgstr "Estirar la imagen para usarla como fondo de portada"

#: dialogs.py:1375
msgid ""
"Check this to overlay text on the image background.\n"
"Uncheck this to place text around the image."
msgstr ""
"Marcar para superponer el texto sobre el fondo de la imagen.\n"
"Desmarcar esta opción para colocar el texto alrededor de la imagen."

#: dialogs.py:1388
msgid "Image border:"
msgstr "Borde de la imagen:"

#: dialogs.py:1390
msgid "The width in pixels of a border around the edge of the image"
msgstr "El ancho en píxeles de un borde alrededor de la imagen"

#: dialogs.py:1402
msgid ""
"Choose the image border color (if it is not stretched to the cover edge)"
msgstr ""
"Elegir el color del borde de la imagen (si no se estira hasta el límite de "
"la portada)"

#: dialogs.py:1408
msgid "Reset image border color"
msgstr "Restablecer el color del borde de la imagen"

#: dialogs.py:1421 dialogs.py:1428
msgid "Font:"
msgstr "Tipo de letra:"

#: dialogs.py:1432
msgid "Choose the font family for the selected field"
msgstr "Elegir el tipo de letra para el campo seleccionado"

#: dialogs.py:1440
msgid "Font size in pixels"
msgstr "Tamaño de letra en píxeles"

#: dialogs.py:1447
msgid "Use this font family for all text"
msgstr "Usar este tipo de letra para todo el texto"

#: dialogs.py:1448
msgid ""
"When checked, this font family is used for all text content on the cover"
msgstr ""
"Cuando está marcado, este tipo de letra se usa para todo el texto de la "
"portada"

#: dialogs.py:1451
msgid "Auto-reduce font size to fit on one line"
msgstr ""
"Reducir automáticamente el tamaño de letra para que quepa en una línea"

