msgid "What do you want to do?"
msgstr "Co chcete udělat?"

#: dialogs.py:135
msgid "Discard Changes"
msgstr "Zahodit změny"

#: dialogs.py:136
msgid "Revert unsaved changes"
msgstr "Zahodit neuložené změny"

#: dialogs.py:138
msgid "Save Changes"
msgstr "Uložit změny"

#: dialogs.py:139
msgid "Overwrite current profile with these changes"
msgstr "Přepsat aktuální profil těmito změnami"

#: dialogs.py:158
msgid "Generate && Save"
msgstr "Generovat && uložit"

#: dialogs.py:159
msgid "Generate cover using these settings and save for future usage"
msgstr ""
"Vygenerovat obálku s těmito nastaveními a uložit je pro budoucí použití"

#: dialogs.py:161
msgid "Generate && Revert"
msgstr "Generovat && zahodit změny"

#: dialogs.py:162
msgid "Generate cover using these settings then discard them"
msgstr "Vygenerovat obálku s těmito nastaveními a potom je zahodit"

#: dialogs.py:166
msgid "Cancel action"
msgstr "Zrušit akci"

#: dialogs.py:481 dialogs.py:559
msgid "Saved Settings:"
