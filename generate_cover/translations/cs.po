msgid "Cannot remove"
msgstr "Nelze odebrat"

#: dialogs.py:626
msgid "You cannot remove the default setting"
msgstr "Výchozí nastavení nelze odebrat"

#: dialogs.py:627 dialogs.py:871 dialogs.py:1722 dialogs.py:1741
msgid "Are you sure?"
msgstr "Opravdu?"

#: dialogs.py:628
#, python-format
