#: dialogs.py:917
msgid "You do not have permission to read the file."
msgstr "Nemáte oprávnění ke čtení souboru."

#: dialogs.py:928
msgid "Cannot copy"
msgstr "Nelze kopírovat"

#: dialogs.py:942
msgid "Overwrite existing"
msgstr "Přepsat existující"

#: dialogs.py:943
msgid ""
"An image file already exists with this name. Do you want to overwrite it?"
msgstr "Soubor obrázku s tímto názvem už existuje. Chcete ho přepsat?"

#: dialogs.py:946
msgid "Enter image name"
msgstr "Zadejte název obrázku"

#: dialogs.py:947
msgid "Enter a unique name for this image:"
msgstr "Zadejte jedinečný název tohoto obrázku:"

#: dialogs.py:961
msgid "You do not have permission to overwrite the file"
msgstr "Nemáte oprávnění k přepsání souboru"

#: dialogs.py:997 dialogs.py:1005
msgid "Title"
msgstr "Název"

#: dialogs.py:998 dialogs.py:1006
msgid "Author"
msgstr "Autor"

#: dialogs.py:999 dialogs.py:1007
msgid "Series"
msgstr "Série"

#: dialogs.py:1000 dialogs.py:1008
msgid "Custom"
msgstr "Vlastní"

#: dialogs.py:1001 dialogs.py:1009
msgid "Custom 2"
msgstr "Vlastní 2"

#: dialogs.py:1002 dialogs.py:1010
msgid "Custom 3"
msgstr "Vlastní 3"

#: dialogs.py:1019 dialogs.py:1262 dialogs.py:1417
msgid "Color:"
msgstr "Barva:"

#: dialogs.py:1024
msgid "Fill Color:"
msgstr "Barva výplně:"

#: dialogs.py:1026
msgid "Choose selected field fill color"
msgstr "Vybrat barvu výplně pro vybrané pole"

#: dialogs.py:1030
msgid "Reset selected field fill color"
msgstr "Obnovit barvu výplně vybraného pole"

#: dialogs.py:1033
msgid "Use this fill color for all text"
msgstr "Použít tuto barvu výplně pro všechen text"

#: dialogs.py:1034
msgid ""
"When checked, the current fill color is used for all text.\n"
"When unchecked, you can set a different fill color for each field."
msgstr ""
"Pokud je zaškrtnuto, aktuální barva výplně se použije pro všechen text.\n"
"Pokud zaškrtnuto není, můžete pro každé pole nastavit jinou barvu výplně."

#: dialogs.py:1044
msgid "Backdrop:"
msgstr "Podklad:"

#: dialogs.py:1045
msgid "Optionally render a color backdrop for this element"
msgstr "Volitelně vykreslit barevný podklad tohoto prvku"

#: dialogs.py:1049
msgid "Choose this element's backdrop color, if applied"
msgstr "Vybrat barvu podkladu tohoto prvku, pokud se používá"

#: dialogs.py:1053
msgid "Reset selected field backdrop color"
msgstr "Obnovit barvu podkladu vybraného pole"

#: dialogs.py:1055
msgid "Use this backdrop for all text"
msgstr "Použít tento podklad pro všechen text"

#: dialogs.py:1063
msgid "Opacity:"
msgstr "Krytí:"

#: dialogs.py:1068
msgid "Full width or height"
msgstr "Celá šířka nebo výška"

#: dialogs.py:1069
msgid ""
"When checked, the backdrop will extend to the full width of the cover (height if rotated).\n"
"When unchecked, the backdrop will only extend to the width or height of the text."
msgstr ""
"Pokud je zaškrtnuto, podklad se roztáhne na celou šířku obálky (při otočení na celou výšku).\n"
"Pokud zaškrtnuto není, podklad bude mít pouze šířku nebo výšku textu."

#: dialogs.py:1155
msgid "Size:"
msgstr "Velikost:"

#: dialogs.py:1161
msgid "Cover width:"
msgstr "Šířka obálky:"

#: dialogs.py:1162
msgid "The width in pixels of the output .jpg file"
msgstr "Šířka výstupního souboru .jpg v pixelech"

#: dialogs.py:1168
msgid "Height:"
msgstr "Výška:"

#: dialogs.py:1169
msgid "The height in pixels of the output .jpg file"
msgstr "Výška výstupního souboru .jpg v pixelech"

#: dialogs.py:1178
msgid "Background:"
msgstr "Pozadí:"

#: dialogs.py:1181
msgid "Choose the background color"
msgstr "Vybrat barvu pozadí"

#: dialogs.py:1186
msgid "Reset background color"
msgstr "Obnovit barvu pozadí"

#: dialogs.py:1189
msgid "Resize cover dimensions to match background image"
msgstr "Změnit rozměry obálky podle obrázku na pozadí"

#: dialogs.py:1190
msgid ""
"Check this to automatically resize the cover based on\n"
"the dimensions of the currently chosen background image"
msgstr ""
"Zaškrtněte, pokud chcete automaticky změnit velikost obálky\n"
"podle rozměrů aktuálně vybraného obrázku na pozadí"

#: dialogs.py:1194
msgid "Resize image to scale up if smaller than available area"
msgstr "Zvětšit obrázek, pokud je menší než dostupná oblast"

#: dialogs.py:1195
msgid ""
"Check this to automatically resize the cover image to fit the\n"
"the maximum area available if it is too small"
msgstr ""
"Zaškrtněte, pokud chcete automaticky zvětšit obrázek obálky tak,\n"
"aby se vešel do maximální dostupné oblasti, pokud je příliš malý"

#: dialogs.py:1201
msgid "Margins:"
msgstr "Okraje:"

#: dialogs.py:1208
msgid "Top:"
msgstr "Nahoře:"

#: dialogs.py:1209
msgid ""
"The margin in pixels from the top of the cover\n"
"to the first content"
msgstr ""
"Okraj v pixelech od horního okraje obálky\n"
"k prvnímu obsahu"

#: dialogs.py:1217 dialogs.py:1332
msgid "Bottom:"
msgstr "Dole:"

#: dialogs.py:1218
msgid ""
"The margin in pixels from the bottom of the cover\n"
"to the last content"
msgstr ""
"Okraj v pixelech od dolního okraje obálky\n"
"k poslednímu obsahu"

#: dialogs.py:1228
msgid "Left:"
msgstr "Vlevo:"

#: dialogs.py:1229
msgid ""
"The minimum margin in pixels from the left of the cover\n"
"to the text content"
msgstr ""
"Minimální okraj v pixelech od levého okraje obálky\n"
"k textovému obsahu"

#: dialogs.py:1237 dialogs.py:1333
msgid "Right:"
msgstr "Vpravo:"

#: dialogs.py:1238
msgid ""
"The minimum margin in pixels from the right of the cover\n"
"to the text content"
msgstr ""
"Minimální okraj v pixelech od pravého okraje obálky\n"
"k textovému obsahu"

#: dialogs.py:1247 dialogs.py:1401
msgid "Border:"
msgstr "Ohraničení:"

#: dialogs.py:1253
msgid "Border width:"
msgstr "Šířka ohraničení:"

#: dialogs.py:1254
msgid ""
"The width in pixels of a border around the edge\n"
"of the cover. Specify 0 for no border"
msgstr ""
"Šířka ohraničení kolem okraje obálky v pixelech.\n"
"Pokud ohraničení nechcete, zadejte 0"

#: dialogs.py:1265
msgid "Choose the border color"
msgstr "Vybrat barvu ohraničení"

#: dialogs.py:1270
msgid "Reset border color"
msgstr "Obnovit barvu ohraničení"

#: dialogs.py:1332
msgid "Padding Top:"
msgstr "Odsazení nahoře:"

#: dialogs.py:1333
msgid "Padding Left:"
msgstr "Odsazení vlevo:"

#: dialogs.py:1362
msgid "Field Order:"
msgstr "Pořadí polí:"

#: dialogs.py:1363
msgid ""
"Alter the order of items on the cover and\n"
"whether they are displayed using the checkbox"
msgstr ""
"Změňte pořadí položek na obálce a pomocí\n"
"zaškrtávacího políčka určete, zda se mají zobrazit"

#: dialogs.py:1377
msgid "Move field up"
msgstr "Přesunout pole nahoru"

#: dialogs.py:1383
msgid "Move field down"
msgstr "Přesunout pole dolů"

#: dialogs.py:1389
msgid "Image:"
msgstr "Obrázek:"

#: dialogs.py:1393
msgid "Stretch image to use as cover background"
msgstr "Roztáhnout obrázek a použít ho jako pozadí obálky"

#: dialogs.py:1394
msgid ""
"Check this to overlay text on the image background.\n"
"Uncheck this to place text around the image."
msgstr ""
"Zaškrtněte, pokud chcete text překrýt přes obrázek na pozadí.\n"
"Zrušte zaškrtnutí, pokud chcete text umístit kolem obrázku."

#: dialogs.py:1407
msgid "Image border:"
msgstr "Ohraničení obrázku:"

#: dialogs.py:1409
msgid "The width in pixels of a border around the edge of the image"
msgstr "Šířka ohraničení kolem okraje obrázku v pixelech"

#: dialogs.py:1421
msgid ""
"Choose the image border color (if it is not stretched to the cover edge)"
msgstr ""
"Vybrat barvu ohraničení obrázku (pokud obrázek není roztažen k okraji "
"obálky)"

#: dialogs.py:1427
msgid "Reset image border color"
msgstr "Obnovit barvu ohraničení obrázku"

#: dialogs.py:1440 dialogs.py:1447
msgid "Font:"
msgstr "Písmo:"

#: dialogs.py:1451
msgid "Choose the font family for the selected field"
msgstr "Vybrat rodinu písem pro vybrané pole"

#: dialogs.py:1459
msgid "Font size in pixels"
msgstr "Velikost písma v pixelech"

#: dialogs.py:1466
msgid "Use this font family for all text"
msgstr "Použít tuto rodinu písem pro všechen text"

#: dialogs.py:1467
msgid ""
"When checked, this font family is used for all text content on the cover"
msgstr ""
"Pokud je zaškrtnuto, tato rodina písem se použije pro veškerý textový obsah "
"na obálce"

#: dialogs.py:1470
msgid "Auto-reduce font size to fit on one line"
msgstr "Automaticky zmenšit písmo, aby se vešlo na jeden řádek"

#: dialogs.py:1471
msgid ""
"When checked, this font size will be used as a maximum size.\n"
