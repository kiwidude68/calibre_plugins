msgstr "Zadaný název není jedinečný"

#: dialogs.py:644 dialogs.py:887
msgid "Cannot remove"
msgstr "Nelze odebrat"

#: dialogs.py:645
msgid "You cannot remove the default setting"
msgstr "Výchozí nastavení nelze odebrat"

#: dialogs.py:646 dialogs.py:890 dialogs.py:1754 dialogs.py:1773
msgid "Are you sure?"
msgstr "Opravdu?"

#: dialogs.py:647
#, python-format
