msgstr "Vyberte soubory nastavení k importu"

#: dialogs.py:786 dialogs.py:792
msgid "GC Files"
msgstr "Soubory Generate Cover"

#: dialogs.py:792
msgid "Save setting as"
msgstr "Uložit nastavení jako"

#: dialogs.py:819
msgid "You cannot rename this image"
msgstr "Tento obrázek nelze přejmenovat"

#: dialogs.py:821 dialogs.py:822
msgid "New image name:"
msgstr "Nový název obrázku:"

#: dialogs.py:839
msgid "File exists"
msgstr "Soubor existuje"

#: dialogs.py:840
msgid "An image already exists with this name."
msgstr "Obrázek s tímto názvem už existuje."

#: dialogs.py:845
msgid "Failed to rename image"
msgstr "Nepodařilo se přejmenovat obrázek"

#: dialogs.py:854
msgid "Add cover images"
msgstr "Přidat obrázky obálek"

#: dialogs.py:869
msgid "You cannot remove this image"
msgstr "Tento obrázek nelze odebrat"

#: dialogs.py:872
#, python-format
msgid "Are you sure you want to delete the image: %s"
msgstr "Opravdu chcete odstranit obrázek: %s"

#: dialogs.py:883 dialogs.py:941
msgid "Cannot write"
msgstr "Nelze zapisovat"

#: dialogs.py:884
