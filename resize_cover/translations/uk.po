msgstr "Змінити розміри, якщо ширина є більшою за це значення"

#: config.py:234
msgid "Width greater than condition"
msgstr "Ширина більша за значення з умови"

#: config.py:247
msgid "Resize if height is less than this value"
msgstr "Змінити розміри, якщо висота є меншою за це значення"

#: config.py:248
msgid "Height less than condition"
msgstr "Висота менша за значення з умови"

#: config.py:262
